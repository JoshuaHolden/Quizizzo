@using Quizizzo.GameContracts

<div class="text-controller">
    <label for="text-answer" class="form-label fw-semibold">Your answer</label>
    <textarea id="text-answer"
              class="form-control"
              rows="4"
              maxlength="@Configuration.MaximumLength"
              placeholder="@Configuration.Placeholder"
              disabled="@Disabled"
              @bind="value"
              @bind:event="oninput"></textarea>
    <div class="controller-meta mt-1">
        <span class="form-text">Keep it short and readable.</span>
        <span class="form-text" aria-live="polite">@CharacterCount/@Configuration.MaximumLength</span>
    </div>
    <button type="button"
            class="btn btn-primary btn-lg w-100 mt-2"
            disabled="@(Disabled || string.IsNullOrWhiteSpace(value) || CharacterCount > Configuration.MaximumLength)"
            @onclick="SubmitAsync">
        @SubmitLabel
    </button>
</div>

@code {
    [Parameter, EditorRequired] public TextControllerConfiguration Configuration { get; set; } = default!;
    [Parameter] public string SubmitLabel { get; set; } = "Send my answer";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> Submitted { get; set; }

    private string value = string.Empty;
    private int CharacterCount => value.Length;

    protected override void OnParametersSet()
    {
        if (value.Length == 0 && Configuration.SubmittedValue is { } submitted)
        {
            value = submitted;
        }
    }

    private Task SubmitAsync() => string.IsNullOrWhiteSpace(value)
        ? Task.CompletedTask
        : Submitted.InvokeAsync(value);
}
