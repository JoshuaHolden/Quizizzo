@using Quizizzo.GameContracts

<OptionController Options="Configuration.Options"
                  SelectionScope="Configuration.SelectionScope"
                  SubmittedOptionId="Configuration.SubmittedOptionId"
                  Legend="Choose one answer"
                  SubmitLabel="@SubmitLabel"
                  Disabled="Disabled"
                  Submitted="Submitted" />

@code {
    [Parameter, EditorRequired] public ChoiceControllerConfiguration Configuration { get; set; } = default!;
    [Parameter] public string SubmitLabel { get; set; } = "Lock in my answer";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> Submitted { get; set; }

}
