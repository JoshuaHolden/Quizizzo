@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Quizizzo.Web.Presentation
@inject IJSRuntime JavaScript

<div id="@elementId" class="phaser-presentation @(CanManagePlayers ? "host-interactive" : null)" aria-hidden="true"></div>

@code {
    [Parameter, EditorRequired] public PhaserPresentationSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback Started { get; set; }
    [Parameter] public bool CanManagePlayers { get; set; }
    [Parameter] public EventCallback<Guid> RemovePlayerRequested { get; set; }

    private readonly string presentationKey = Guid.NewGuid().ToString("N");
    private readonly string elementId = $"quizizzo-phaser-{Guid.NewGuid():N}";
    private bool started;
    private bool updatePending = true;
    private DotNetObjectReference<PhaserPresentation>? dotNetReference;

    protected override void OnParametersSet() => updatePending = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                dotNetReference = DotNetObjectReference.Create(this);
                await JavaScript.InvokeVoidAsync(
                    "quizizzoPresentation.start", presentationKey, elementId, Snapshot,
                    dotNetReference, CanManagePlayers);
                if (CanManagePlayers)
                {
                    await JavaScript.InvokeVoidAsync(
                        "quizizzoPresentation.configureHost", presentationKey, dotNetReference);
                }
                started = true;
                updatePending = false;
                await Started.InvokeAsync();
                return;
            }

            if (started && updatePending)
            {
                await JavaScript.InvokeVoidAsync(
                    "quizizzoPresentation.update", presentationKey, Snapshot);
                updatePending = false;
            }
        }
        catch (JSException)
        {
            // Accessible HTML remains usable if canvas rendering is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (started)
            {
                await JavaScript.InvokeVoidAsync("quizizzoPresentation.stop", presentationKey);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
        }
        finally
        {
            dotNetReference?.Dispose();
            dotNetReference = null;
        }
    }

    public async Task ReactAsync(Guid playerId, string reaction)
    {
        if (started)
        {
            await JavaScript.InvokeVoidAsync(
                "quizizzoPresentation.react", presentationKey, playerId.ToString("N"), reaction);
        }
    }

    [JSInvokable]
    public Task RequestPlayerRemoval(string playerId) =>
        Guid.TryParse(playerId, out var parsed)
            ? RemovePlayerRequested.InvokeAsync(parsed)
            : Task.CompletedTask;
}
