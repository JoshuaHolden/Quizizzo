@using Quizizzo.GameContracts
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="voice-recording-controller" aria-label="VoiceChoon sound recorder">
    <header class="voice-recording-header">
        <div>
            <span>Your voice · your instrument</span>
            <strong>@RecordedCount of @Configuration.Prompts.Count recorded</strong>
        </div>
        @if (EndsAtUtc is not null)
        {
            <span class="voice-recording-timer"><DeadlineCountdown EndsAtUtc="EndsAtUtc" /></span>
        }
    </header>

    <div class="voice-recording-list">
        @foreach (var prompt in Configuration.Prompts)
        {
            var state = StateFor(prompt);
            <article class="voice-recording-card @(state.AssetId is not null ? "accepted" : state.HasRecording ? "recorded" : null)">
                <span class="voice-recording-number" aria-hidden="true">@PromptNumber(prompt)</span>
                <div class="voice-recording-copy">
                    <span class="voice-recording-label">@prompt.Label</span>
                    <strong>@prompt.Example</strong>
                    <small>@prompt.Guidance</small>
                </div>
                <div class="voice-recording-actions">
                    @if (state.Status == "recording")
                    {
                        <button type="button" class="voice-record-stop" @onclick="() => StopAsync(prompt.Key)">
                            <span aria-hidden="true">■</span> Stop
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="voice-record-button"
                                disabled="@(Disabled || recordingKey is not null || state.AssetId is not null)"
                                @onclick="() => StartAsync(prompt.Key)"
                                aria-label="Record @prompt.Example">
                            <span aria-hidden="true">●</span> @(state.HasRecording ? "Redo" : "Record")
                        </button>
                    }
                    @if (state.HasRecording && state.Status != "recording" && state.AssetId is null)
                    {
                        <button type="button" class="voice-preview-button" @onclick="() => PreviewAsync(prompt.Key)">
                            <span aria-hidden="true">▶</span> Play
                        </button>
                    }
                    @if (state.AssetId is not null)
                    {
                        <span class="voice-recording-done" aria-label="Uploaded">✓</span>
                    }
                </div>
            </article>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="controller-notice" role="alert">@error</p>
    }
    @if (microphoneBlocked)
    {
        <aside class="microphone-recovery" aria-labelledby="microphone-recovery-title">
            <span aria-hidden="true">🎤</span>
            <div>
                <strong id="microphone-recovery-title">Microphone is blocked</strong>
                @if (microphoneEnvironment == "brave-ios")
                {
                    <p>On your iPhone, open <b>Settings → Privacy &amp; Security → Microphone</b>
                        and switch <b>Brave</b> on. Then come back here.</p>
                    <small>If Brave still blocks it, open Quizizzo in Safari and join with the same code.</small>
                }
                else if (microphoneEnvironment == "ios")
                {
                    <p>Open <b>Settings → Privacy &amp; Security → Microphone</b> and switch your browser on.
                        Then come back here.</p>
                }
                else
                {
                    <p>Allow microphone access for quizizzo.com in your browser's site settings, then try again.</p>
                }
                <button type="button" class="microphone-retry" @onclick="RetryMicrophoneAsync">
                    Check again
                </button>
            </div>
        </aside>
    }
    <button type="button"
            class="voice-lock-button"
            disabled="@(Disabled || RecordedCount != Configuration.Prompts.Count || confirming)"
            @onclick="UploadAllAsync">
        @if (confirming)
        {
            <span class="voice-upload-spinner" aria-hidden="true"></span>
            <span>Sending sound pack… @AcceptedCount/@Configuration.Prompts.Count</span>
        }
        else
        {
            <span>Send my sound pack</span><span aria-hidden="true">↗</span>
        }
    </button>
    <small class="voice-upload-note">Record and replay everything first. Your sounds upload together at the end.</small>
</section>

@code {
    [Parameter, EditorRequired] public RecordingControllerConfiguration Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public Guid GameInstanceId { get; set; }
    [Parameter] public DateTimeOffset? EndsAtUtc { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Confirmed { get; set; }

    private readonly Dictionary<string, RecordingUiState> states = new(StringComparer.Ordinal);
    private IJSObjectReference? module;
    private IJSObjectReference? controller;
    private DotNetObjectReference<RecordingController>? dotNetReference;
    private string? recordingKey;
    private string? error;
    private bool confirming;
    private string microphoneEnvironment = "other";
    private string? retryPromptKey;
    private bool microphoneBlocked;
    private int AcceptedCount => Configuration.Prompts.Count(prompt => StateFor(prompt).AssetId is not null);
    private int RecordedCount => Configuration.Prompts.Count(prompt =>
        StateFor(prompt) is { HasRecording: true } || StateFor(prompt).AssetId is not null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        foreach (var prompt in Configuration.Prompts)
        {
            states[prompt.Key] = new RecordingUiState(prompt.AssetId is not null, prompt.AssetId, "idle");
        }
        module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/voiceRecorder.js");
        microphoneEnvironment = await module.InvokeAsync<string>("microphoneEnvironment");
        dotNetReference = DotNetObjectReference.Create(this);
        controller = await module.InvokeAsync<IJSObjectReference>(
            "createVoiceRecorder",
            dotNetReference,
            Configuration.MaximumDurationSeconds,
            Configuration.MaximumBytesPerSample);
    }

    [JSInvokable]
    public async Task RecordingChanged(string promptKey, bool hasRecording, string status)
    {
        var previous = states.GetValueOrDefault(promptKey) ?? new RecordingUiState(false, null, "idle");
        states[promptKey] = previous with { HasRecording = hasRecording, Status = status };
        if (status != "recording" && recordingKey == promptKey)
        {
            recordingKey = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private RecordingUiState StateFor(RecordingPromptConfiguration prompt) =>
        states.GetValueOrDefault(prompt.Key)
        ?? new RecordingUiState(prompt.AssetId is not null, prompt.AssetId, "idle");

    private int PromptNumber(RecordingPromptConfiguration prompt)
    {
        for (var index = 0; index < Configuration.Prompts.Count; index++)
        {
            if (string.Equals(Configuration.Prompts[index].Key, prompt.Key, StringComparison.Ordinal)) return index + 1;
        }
        return 0;
    }

    private async Task StartAsync(string promptKey)
    {
        if (controller is null)
        {
            return;
        }
        error = null;
        microphoneBlocked = false;
        retryPromptKey = promptKey;
        await StartRecordingAsync(promptKey);
    }

    private async Task RetryMicrophoneAsync()
    {
        var permission = await module!.InvokeAsync<string>("microphonePermissionState");
        if (permission == "unavailable")
        {
            error = "Microphone recording needs a modern browser and a secure HTTPS connection.";
            return;
        }
        microphoneBlocked = false;
        error = null;
        if (retryPromptKey is not null) await StartRecordingAsync(retryPromptKey);
    }

    [JSInvokable]
    public async Task MicrophonePermissionRechecked(string permission)
    {
        if (permission == "granted" && microphoneBlocked)
        {
            microphoneBlocked = false;
            error = "Microphone enabled — tap Record to make your sound.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartRecordingAsync(string promptKey)
    {
        if (controller is null)
        {
            return;
        }
        try
        {
            recordingKey = promptKey;
            await controller.InvokeVoidAsync("start", promptKey);
            states[promptKey] = new RecordingUiState(false, null, "recording");
        }
        catch (JSException exception)
        {
            recordingKey = null;
            microphoneBlocked = exception.Message.Contains("MICROPHONE_BLOCKED", StringComparison.Ordinal);
            error = microphoneBlocked
                ? "Your browser did not allow microphone access."
                : exception.Message.Replace("MICROPHONE_UNAVAILABLE|", string.Empty, StringComparison.Ordinal);
        }
    }

    private async Task StopAsync(string promptKey)
    {
        if (controller is not null)
        {
            await controller.InvokeVoidAsync("stop", promptKey);
        }
    }

    private async Task PreviewAsync(string promptKey)
    {
        if (controller is not null)
        {
            await controller.InvokeVoidAsync("play", promptKey);
        }
    }

    private async Task UploadAllAsync()
    {
        if (controller is null || confirming || RecordedCount != Configuration.Prompts.Count)
        {
            return;
        }
        confirming = true;
        error = null;
        try
        {
            var prompts = Configuration.Prompts.ToArray();
            foreach (var prompt in prompts.Where(item => StateFor(item).AssetId is null))
            {
                states[prompt.Key] = states[prompt.Key] with { Status = "uploading" };
                await InvokeAsync(StateHasChanged);
                var assetId = await controller.InvokeAsync<Guid>(
                    "upload",
                    prompt.Key,
                    Configuration.UploadEndpoint,
                    GameInstanceId.ToString("D"));
                states[prompt.Key] = new RecordingUiState(true, assetId, "ready");
                await InvokeAsync(StateHasChanged);
            }
            await Confirmed.InvokeAsync();
        }
        catch (JSException)
        {
            foreach (var prompt in Configuration.Prompts.Where(item => StateFor(item).Status == "uploading"))
            {
                states[prompt.Key] = states[prompt.Key] with { Status = "ready" };
            }
            error = "One sound did not upload. Your recordings are still here — tap Send again.";
        }
        finally
        {
            confirming = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
        }
        dotNetReference?.Dispose();
    }

    private sealed record RecordingUiState(bool HasRecording, Guid? AssetId, string Status);
}
