@using Quizizzo.GameContracts

<OptionController Options="Configuration.Options"
                  SelectionScope="Configuration.SelectionScope"
                  SubmittedOptionId="Configuration.SubmittedOptionId"
                  Legend="Choose one option"
                  SubmitLabel="@SubmitLabel"
                  ShowFrameAnimations="HasFrameAnimations"
                  ReviewBeforeSubmit="HasFrameAnimations"
                  Disabled="Disabled"
                  Submitted="Submitted" />

@code {
    [Parameter, EditorRequired] public VoteControllerConfiguration Configuration { get; set; } = default!;
    [Parameter] public string SubmitLabel { get; set; } = "Cast my vote";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> Submitted { get; set; }

    private bool HasFrameAnimations => Configuration.Options.Any(
        option => option.FrameAssetIds is { Count: > 0 });
}
