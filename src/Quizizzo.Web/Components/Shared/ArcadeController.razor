@using Quizizzo.GameContracts
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="arcade-controller @(Configuration.Targets.Count <= 1 ? "arcade-single-target" : null)" aria-label="Arcade controls" tabindex="0"
         @ref="controllerElement">
    <header class="arcade-status-strip">
        <div>
            <span>Chaos</span>
            <strong>@ChargePercent%</strong>
        </div>
        <div class="arcade-charge-meter" role="progressbar" aria-label="Chaos charge"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ChargePercent">
            <span style="width: @(ChargePercent)%"></span>
        </div>
        <strong class="arcade-ability @(Configuration.AvailableAbility is null ? "empty" : null)">
            @(Configuration.AvailableAbility ?? "NO ABILITY")
        </strong>
        @if (EndsAtUtc is not null)
        {
            <span class="arcade-deadline"><DeadlineCountdown EndsAtUtc="EndsAtUtc" /></span>
        }
    </header>

    @if (Configuration.Targets.Count > 1)
    {
        <fieldset class="arcade-targets">
            <legend>Target</legend>
            @foreach (var target in Configuration.Targets)
            {
                <button type="button"
                        class="@(target.Id == selectedTargetId ? "selected" : null)"
                        disabled="@Disabled"
                        aria-pressed="@(target.Id == selectedTargetId)"
                    data-arcade-target="@target.Id">
                    <strong>@target.Label</strong>
                </button>
            }
        </fieldset>
    }

    @if (Configuration.Arena is not null)
    {
        <section class="arcade-arena-shell" aria-label="Your scrapyard">
            <canvas class="arcade-arena-canvas" width="270" height="510" data-arcade-arena></canvas>
            <div class="arcade-next-pieces" data-arcade-next aria-label="Upcoming pieces"></div>
        </section>
    }

    <div class="arcade-control-deck">
        @foreach (var control in MovementControls)
        {
            <button type="button"
                    class="arcade-control arcade-control-@ControlClass(control.Input)"
                    disabled="@Disabled"
                    aria-label="@control.AccessibleLabel"
                    data-arcade-input="@control.Input"
                    data-arcade-repeat="@control.HoldRepeatMilliseconds">
                <span aria-hidden="true">@control.Label</span>
            </button>
        }
        @if (AbilityControl is { } ability)
        {
            <button type="button"
                    class="arcade-control arcade-control-ability"
                    disabled="@(Disabled || Configuration.AvailableAbility is null)"
                    aria-label="@ability.AccessibleLabel"
                    data-arcade-input="@ability.Input">
                <span aria-hidden="true">@ability.Label</span>
                <small>@(Configuration.AvailableAbility ?? "CHARGING")</small>
            </button>
        }
    </div>
    <p class="arcade-keyboard-hint">
        Keyboard: arrows move, C stashes/swaps · Space slams · Shift fires chaos
    </p>
</section>

@code {
    [Parameter, EditorRequired] public ArcadeControllerConfiguration Configuration { get; set; } = default!;
    [Parameter, EditorRequired] public string ConnectionKey { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ActionKind { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset? EndsAtUtc { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference controllerElement;
    private IJSObjectReference? module;
    private IJSObjectReference? controller;
    private string? selectedTargetId;
    private int ChargePercent => Math.Clamp(Configuration.ChargePercent, 0, 100);
    private IEnumerable<ArcadeControl> MovementControls =>
        Configuration.Controls.Where(control => control.Input != "ActivateAbility");
    private ArcadeControl? AbilityControl =>
        Configuration.Controls.FirstOrDefault(control => control.Input == "ActivateAbility");

    protected override void OnParametersSet()
    {
        if (selectedTargetId is null || Configuration.Targets.All(target => target.Id != selectedTargetId))
        {
            selectedTargetId = Configuration.SelectedTargetId is { } selected &&
                Configuration.Targets.Any(target => target.Id == selected)
                    ? selected
                    : Configuration.Targets.FirstOrDefault()?.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/arcadeController.js");
            controller = await module.InvokeAsync<IJSObjectReference>(
                "create", controllerElement, ConnectionKey, ActionKind, ControllerState());
        }
        else if (controller is not null)
        {
            await controller.InvokeVoidAsync("update", ControllerState());
        }
    }

    private object ControllerState() => new
    {
        Configuration.NextSequence,
        SelectedTargetId = selectedTargetId,
        Disabled,
        Configuration.Arena
    };

    private static string ControlClass(string input) => input switch
    {
        "MoveLeft" => "left",
        "MoveRight" => "right",
        "RotateClockwise" => "rotate",
        "SoftDrop" => "soft-drop",
        "InstantDrop" => "instant-drop",
        _ => "action"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
        }
    }
}
