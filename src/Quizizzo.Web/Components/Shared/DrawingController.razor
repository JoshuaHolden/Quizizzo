@using Quizizzo.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="drawing-controller" aria-label="Drawing controller">
    <div class="drawing-context-bar">
        @if (!string.IsNullOrWhiteSpace(Prompt))
        {
            <strong class="drawing-prompt">@Prompt</strong>
        }
        @if (EndsAtUtc is not null)
        {
            <span class="drawing-time-pill"><DeadlineCountdown EndsAtUtc="EndsAtUtc" /></span>
        }
    </div>

    <div class="drawing-canvas-stack" style="aspect-ratio: @Options.LogicalWidth / @Options.LogicalHeight">
        <canvas @ref="onionCanvas" class="drawing-canvas drawing-onion-canvas" aria-hidden="true"></canvas>
        <canvas @ref="drawingCanvas"
                class="drawing-canvas drawing-input-canvas"
                aria-label="Draw here using touch, a stylus, or a mouse"></canvas>
        @if (Options.FrameCount > 1)
        {
            <span class="drawing-frame-badge" aria-live="polite">@state.CurrentFrame / @state.FrameCount</span>
        }
    </div>

    <div class="drawing-command-dock" aria-label="Drawing tools and frames">
        <button type="button"
                class="drawing-dock-button"
                @onclick="ToggleBrushPanel"
                aria-label="Choose pen colour and size"
                aria-expanded="@brushPanelOpen"
                aria-controls="drawing-brush-panel">
            <span class="drawing-colour-swatch" style="background-color: @state.SelectedColour"></span>
            <span class="drawing-size-dot" style="width: @SizePreview; height: @SizePreview"></span>
        </button>
        <button type="button"
                class="drawing-dock-button @(state.Tool == "eraser" ? "active" : null)"
                aria-pressed="@(state.Tool == "eraser")"
                aria-label="Toggle eraser"
                title="Eraser"
                @onclick="ToggleEraserAsync">
            <span aria-hidden="true">⌫</span>
        </button>
        <button type="button"
                class="drawing-dock-button"
                disabled="@(!state.CanUndo)"
                aria-label="Undo last stroke"
                title="Undo"
                @onclick="UndoAsync">
            <span aria-hidden="true">↶</span>
        </button>
        @if (Options.FrameCount > 1)
        {
            <span class="drawing-dock-divider" aria-hidden="true"></span>
            <button type="button"
                    class="drawing-dock-button"
                    disabled="@(state.CurrentFrame <= 1)"
                    aria-label="Previous frame"
                    @onclick="PreviousFrameAsync">
                <span aria-hidden="true">‹</span>
            </button>
            <span class="drawing-frame-position" aria-label="Frame @state.CurrentFrame of @state.FrameCount">@state.CurrentFrame/@state.FrameCount</span>
            <button type="button"
                    class="drawing-dock-button"
                    disabled="@(state.CurrentFrame >= state.FrameCount)"
                    aria-label="Next frame"
                    @onclick="NextFrameAsync">
                <span aria-hidden="true">›</span>
            </button>
        }
    </div>

    @if (brushPanelOpen)
    {
        <aside id="drawing-brush-panel" class="drawing-brush-popover" role="dialog" aria-label="Pen settings">
            <div class="drawing-popover-header">
                <strong>Pen settings</strong>
                <button type="button" @onclick="CloseBrushPanel" aria-label="Close pen settings">×</button>
            </div>
            <fieldset>
                <legend>Colour</legend>
                <div class="drawing-picker" aria-label="Pen colours">
                    @foreach (var colour in Options.Colours)
                    {
                        <button type="button"
                                class="drawing-palette-choice @(colour == state.SelectedColour ? "selected" : null)"
                                style="background-color: @colour"
                                aria-label="Use colour @colour"
                                aria-pressed="@(colour == state.SelectedColour)"
                                @onclick="() => SelectColourAsync(colour)"></button>
                    }
                </div>
            </fieldset>
            <fieldset>
                <legend>Size</legend>
                <div class="drawing-picker drawing-size-picker" aria-label="Brush sizes">
                    @foreach (var width in Options.Widths)
                    {
                        <button type="button"
                                class="drawing-size-choice @(width == state.SelectedWidth ? "selected" : null)"
                                aria-label="Use brush size @width"
                                aria-pressed="@(width == state.SelectedWidth)"
                                @onclick="() => SelectWidthAsync(width)">
                            <span style="width: @($"{Math.Clamp(width, 4, 28)}px"); height: @($"{Math.Clamp(width, 4, 28)}px")"></span>
                        </button>
                    }
                </div>
            </fieldset>
            <div class="drawing-popover-actions">
                @if (Options.FrameCount > 1)
                {
                    <button type="button"
                            class="@(state.OnionSkinEnabled ? "active" : null)"
                            disabled="@(state.CurrentFrame <= 1)"
                            aria-pressed="@state.OnionSkinEnabled"
                            @onclick="ToggleOnionSkinAsync">
                        <span aria-hidden="true">◉</span> Onion skin
                    </button>
                }
                <button type="button"
                        class="drawing-clear-button @(clearArmed ? "drawing-clear-armed" : null)"
                        disabled="@(!state.CanUndo)"
                        @onclick="ClearAsync">
                    @(clearArmed ? "Tap again to clear" : "Clear frame")
                </button>
            </div>
        </aside>
    }

    @if (showRestoredMessage)
    {
        <p class="drawing-draft-message" role="status">Your saved drawing draft was restored.</p>
    }
    @if (!string.IsNullOrWhiteSpace(submissionError))
    {
        <p class="alert alert-danger mt-2" role="alert">@submissionError</p>
    }
    @if (!string.IsNullOrWhiteSpace(SubmissionEndpoint))
    {
        <button type="button"
                class="drawing-submit-button"
                disabled="@(Disabled || submitting)"
                @onclick="SubmitAsync">
            @(submitting ? "Sending your drawing…" : SubmitLabel)
        </button>
    }
</section>

@code {
    [Parameter, EditorRequired] public DrawingControllerOptions Options { get; set; } = default!;
    [Parameter] public string? Prompt { get; set; }
    [Parameter] public DateTimeOffset? EndsAtUtc { get; set; }
    [Parameter] public EventCallback<DrawingStateSummary> StateChanged { get; set; }
    [Parameter] public string? SubmissionEndpoint { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Send my drawing";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Submitted { get; set; }

    private ElementReference drawingCanvas;
    private ElementReference onionCanvas;
    private IJSObjectReference? module;
    private IJSObjectReference? controller;
    private DotNetObjectReference<DrawingController>? dotNetReference;
    private DrawingStateSummary state = new(
        1, 1, [false], false, DrawingControllerOptions.DefaultColours[0],
        DrawingControllerOptions.DefaultWidths[1], "pen", false, false, DateTimeOffset.UtcNow);
    private bool brushPanelOpen;
    private bool clearArmed;
    private bool showRestoredMessage;
    private bool submitting;
    private string? submissionError;
    private string SizePreview => $"{Math.Clamp(state.SelectedWidth, 5, 22)}px";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Options.Validate();
        state = state with { FrameCount = Options.FrameCount, OnionSkinEnabled = Options.FrameCount > 1 && Options.OnionSkinEnabled };
        module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/drawingCanvas.js");
        dotNetReference = DotNetObjectReference.Create(this);
        controller = await module.InvokeAsync<IJSObjectReference>(
            "create",
            drawingCanvas,
            onionCanvas,
            new
            {
                Options.LogicalWidth,
                Options.LogicalHeight,
                Options.FrameCount,
                Options.Colours,
                Options.Widths,
                identity = new
                {
                    partyId = Options.Identity.PartyId.ToString("N"),
                    gameSessionId = Options.Identity.GameSessionId.ToString("N"),
                    roundId = Options.Identity.RoundId,
                    playerId = Options.Identity.PlayerId.ToString("N")
                },
                Options.OnionSkinEnabled,
                Options.DraftKey,
                Options.DraftFamilyPrefix,
                draftPlayerSuffix = $":{Options.Identity.PlayerId:N}"
            },
            dotNetReference);
    }

    [JSInvokable]
    public async Task HandleDrawingStateChanged(DrawingStateSummary nextState)
    {
        state = nextState;
        clearArmed = false;
        showRestoredMessage = nextState.RestoredDraft;
        await StateChanged.InvokeAsync(nextState);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask<object?> GetDocumentAsync() => controller is null
        ? null
        : await controller.InvokeAsync<object>("getDocument");

    public async ValueTask ClearDraftAsync()
    {
        if (controller is not null)
        {
            await controller.InvokeVoidAsync("clearDraft");
        }
    }

    private async Task SubmitAsync()
    {
        if (controller is null || string.IsNullOrWhiteSpace(SubmissionEndpoint))
        {
            return;
        }
        submitting = true;
        submissionError = null;
        try
        {
            await controller.InvokeAsync<object>(
                "submit",
                SubmissionEndpoint,
                new
                {
                    gameInstanceId = Options.Identity.GameSessionId.ToString("D"),
                    roundId = Options.Identity.RoundId
                });
            await Submitted.InvokeAsync();
        }
        catch (JSException exception)
        {
            submissionError = exception.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private void ToggleBrushPanel()
    {
        brushPanelOpen = !brushPanelOpen;
        clearArmed = false;
    }

    private void CloseBrushPanel() => brushPanelOpen = false;

    private async Task SelectColourAsync(string colour)
    {
        clearArmed = false;
        await InvokeControllerAsync("setColour", colour);
    }

    private async Task SelectWidthAsync(int width)
    {
        clearArmed = false;
        await InvokeControllerAsync("setWidth", width);
    }

    private Task ToggleEraserAsync() => InvokeControllerAsync("setTool", state.Tool == "eraser" ? "pen" : "eraser");

    private Task UndoAsync() => InvokeControllerAsync("undo");

    private async Task ClearAsync()
    {
        if (!clearArmed)
        {
            clearArmed = true;
            return;
        }
        clearArmed = false;
        await InvokeControllerAsync("clearFrame");
    }

    private Task PreviousFrameAsync() => SetFrameAsync(state.CurrentFrame - 2);

    private Task NextFrameAsync() => SetFrameAsync(state.CurrentFrame);

    private async Task SetFrameAsync(int zeroBasedIndex)
    {
        clearArmed = false;
        brushPanelOpen = false;
        await InvokeControllerAsync("setFrame", zeroBasedIndex);
    }

    private Task ToggleOnionSkinAsync() =>
        InvokeControllerAsync("setOnionSkin", !state.OnionSkinEnabled);

    private async Task InvokeControllerAsync(string method, params object?[] args)
    {
        if (controller is not null)
        {
            await controller.InvokeVoidAsync(method, args);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
        }
        dotNetReference?.Dispose();
    }
}
