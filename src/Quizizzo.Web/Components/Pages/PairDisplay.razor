@page "/host/pair-display/{PairingCode}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Quizizzo.Application.Displays
@using Quizizzo.Application.Parties
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PartyService Parties
@inject DisplaySessionService DisplaySessions
@inject NavigationManager Navigation
@inject Quizizzo.Web.Realtime.IPartyRealtimeNotifier Realtime

<PageTitle>Pair display</PageTitle>

<h1>Pair this display</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(paired ? "alert-success" : "alert-info")">@message</div>
}

@if (!paired && loaded)
{
    <p>Display code: <strong>@PairingCode.ToUpperInvariant()</strong></p>
    @if (activeParty is null)
    {
        <p>You do not have an active party yet.</p>
        <button class="btn btn-primary" disabled="@working" @onclick="CreateAndPairAsync">Create party and pair</button>
    }
    else
    {
        <p>Pair with room <strong>@activeParty.RoomCode</strong>?</p>
        <button class="btn btn-primary" disabled="@working" @onclick="PairAsync">Pair display</button>
    }
}

@code {
    [Parameter] public string PairingCode { get; set; } = string.Empty;

    private string hostUserId = string.Empty;
    private string? message;
    private PartyView? activeParty;
    private bool loaded;
    private bool working;
    private bool paired;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hostUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? throw new InvalidOperationException("An authenticated host ID is required.");
        activeParty = await Parties.GetActiveAsync(hostUserId);
        loaded = true;
    }

    private async Task CreateAndPairAsync()
    {
        working = true;
        activeParty = await Parties.CreateAsync(hostUserId);
        await PairAsync();
    }

    private async Task PairAsync()
    {
        if (activeParty is null)
        {
            return;
        }

        working = true;
        try
        {
            var display = await DisplaySessions.PairAsync(PairingCode, activeParty.PartyId, hostUserId);
            await Realtime.DisplaySessionChangedAsync(display.DisplaySessionId, "DisplayPaired");
            await Realtime.PartyChangedAsync(activeParty.PartyId, "DisplayPaired");
            paired = true;
            message = $"Display paired with room {activeParty.RoomCode}.";
        }
        catch (InvalidOperationException exception)
        {
            message = exception.Message;
        }
        finally
        {
            working = false;
        }
    }
}
