@page "/host/party/{PartyId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Quizizzo.Application.Games
@using Quizizzo.Application.Parties
@using Quizizzo.Application.Players
@using Quizizzo.Domain
@using Quizizzo.Domain.Parties
@using Quizizzo.GameContracts
@using Quizizzo.Web.Presentation
@using Quizizzo.Web.Realtime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HostPartyRealtimeService PartyState
@inject NavigationManager Navigation

<PageTitle>Party controls</PageTitle>

<div class="host-control-room">
@if (party is null)
{
    <p>@message</p>
}
else
{
    <PartyRealtimeConnection Role="Host"
                             PartyId="PartyId"
                             StateChanged="RefreshFromServerAsync"
                             ConnectionStatusChanged="SetConnectionStatus" />

    <header class="host-room-hero">
        <div>
            <p class="host-eyebrow">Your live party</p>
            <p class="host-room-label">Room code</p>
            <h1>@party.RoomCode</h1>
        </div>
        <div class="host-room-status">
            <span class="host-status-chip"><i class="host-status-dot" aria-hidden="true"></i>@party.Status</span>
            <span class="host-status-chip @ConnectionBadgeClass" aria-live="polite">@ConnectionLabel</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger" role="alert">@actionError</div>
    }

    @if (gameView is not null && game is not null)
    {
        <section class="game-panel responsive-card card">
            <div class="responsive-heading-row">
                <div>
                    <p class="text-uppercase text-muted mb-1">@gameView.Phase</p>
                    <h2>@game.Title</h2>
                </div>
                @if (gameView.PhaseEndsAtUtc is not null)
                {
                    <span class="badge text-bg-warning fs-6"><DeadlineCountdown EndsAtUtc="gameView.PhaseEndsAtUtc" /></span>
                }
            </div>
            <p class="lead">@game.Prompt</p>
            <p>@game.PhaseMessage</p>

            @if (game.Entries.Count > 0)
            {
                <div class="list-group mb-3">
                    @foreach (var entry in game.Entries)
                    {
                        <div class="list-group-item responsive-list-row">
                            <span><strong>@entry.Label</strong> @entry.Value</span>
                            @if (entry.Rank is not null)
                            {
                                <span>#@entry.Rank · +@entry.PointsAwarded.ToString("N0")</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (game.CanAdvance && game.AdvanceActionKind is not null)
            {
                <button class="btn btn-primary btn-lg mobile-full-width"
                        disabled="@actionPending"
                        @onclick="AdvanceGameAsync">
                    @(actionPending ? "Working..." : game.AdvanceLabel)
                </button>
            }

            <h3 class="h5 mt-4">Scores</h3>
            <ol class="scoreboard">
                @foreach (var score in gameView.Scores.OrderByDescending(pair => pair.Value))
                {
                    <li><span>@PlayerName(score.Key)</span><strong>@score.Value.ToString("N0")</strong></li>
                }
            </ol>
        </section>
    }
    else
    {
        <section class="host-lobby-panel">
            <div class="host-lobby-heading">
                <div>
                    <p class="host-eyebrow">Control room</p>
                    <h2>Get everyone ready</h2>
                    <p>Connect the big screen, welcome your players, then choose the first game.</p>
                </div>
                <span class="host-player-count">@players.Count / @QuizizzoLimits.MaximumPlayers players</span>
            </div>

            <div class="host-lobby-grid">
            <section class="host-lobby-card host-screen-card" aria-labelledby="screen-heading">
                <span class="host-card-icon" aria-hidden="true">▣</span>
                <div>
                    <p class="host-card-kicker">Big screen</p>
                    <h3 id="screen-heading">@(presence.DisplayConnected ? "Display connected" : "Connect your display")</h3>
                    <p>@(presence.DisplayConnected ? "The party screen is live and ready." : "Present here, or pair a TV or projector.")</p>
                </div>
                <div class="host-display-actions">
                <form method="post" action="@($"/host/party/{PartyId}/present")">
                    <AntiforgeryToken />
                    <button class="host-primary-action" type="submit">Present on this device <span aria-hidden="true">→</span></button>
                </form>
                <details>
                    <summary>Connect another screen</summary>
                    <p>
                        On the TV or projector, open <strong>quizizzo.com/display</strong>, then scan the QR code shown there.
                    </p>
                </details>
                </div>
            </section>

            <section class="host-lobby-card host-players-card" aria-labelledby="players-heading">
                <span class="host-card-icon host-card-icon-pink" aria-hidden="true">☺</span>
                <div>
                    <p class="host-card-kicker">Party people</p>
                    <h3 id="players-heading">@presence.Players online</h3>
                    <p aria-live="polite">Players appear here as soon as they join with <strong>@party.RoomCode</strong>.</p>
                </div>
            @if (players.Count == 0)
            {
                <div class="host-empty-roster"><span aria-hidden="true">✦</span> Waiting for the first player…</div>
            }
            else
            {
                <ul class="host-player-list">
                    @foreach (var player in players)
                    {
                        <li>
                            <span class="host-player-initial" aria-hidden="true">@player.DisplayName[..1].ToUpperInvariant()</span>
                            <strong>@player.DisplayName</strong>
                            <span>@player.Status · @player.Score.ToString("N0") pts</span>
                        </li>
                    }
                </ul>
            }
            </section>
            </div>

            <section class="host-game-picker" aria-labelledby="games-heading">
                <div class="host-section-heading">
                    <div>
                        <p class="host-card-kicker">Choose the chaos</p>
                        <h3 id="games-heading">Pick a game</h3>
                    </div>
                    @if (players.Count == 0)
                    {
                        <span>Waiting for players</span>
                    }
                </div>
                <div class="host-game-actions">
                @foreach (var availableGame in availableGames)
                {
                    <button class="host-game-tile host-game-@availableGame.Key"
                            disabled="@(players.Count < availableGame.MinimumPlayers ||
                                players.Count > availableGame.MaximumPlayers || actionPending ||
                                party.Status != PartyStatus.Lobby)"
                            @onclick="() => StartGameAsync(availableGame.Key)">
                        <span class="host-game-icon" aria-hidden="true">@GameIcon(availableGame.Key)</span>
                        <span><strong>@(actionPending ? "Starting..." : availableGame.DisplayName)</strong>
                            <small>@availableGame.MinimumPlayers–@availableGame.MaximumPlayers players</small></span>
                        <span class="host-game-arrow" aria-hidden="true">→</span>
                    </button>
                }
                </div>
            </section>

            <div class="host-danger-zone">
                <div><strong>Finished for now?</strong><span>Closing retires this room code permanently.</span></div>
                <div>
            @if (!closeConfirmationRequested)
            {
                <button class="host-close-action" disabled="@actionPending"
                        @onclick="() => closeConfirmationRequested = true">
                    Close lobby
                </button>
            }
            else
            {
                <div class="host-close-confirmation" role="alert">
                    <strong>Close room @party.RoomCode?</strong>
                    <p>Players will no longer be able to join.</p>
                    <div>
                        <button class="btn btn-danger" disabled="@actionPending" @onclick="CloseLobbyAsync">
                            @(actionPending ? "Closing..." : "Yes, close lobby")
                        </button>
                        <button class="btn btn-secondary" disabled="@actionPending"
                                @onclick="() => closeConfirmationRequested = false">
                            Keep it open
                        </button>
                    </div>
                </div>
            }
                </div>
            </div>
            <small class="host-last-update">Last update: @lastUpdateReason</small>
        </section>
    }
}
</div>

@code {
    [Parameter] public Guid PartyId { get; set; }

    private PartyView? party;
    private IReadOnlyList<PlayerView> players = [];
    private IReadOnlyList<GameDescriptor> availableGames = [];
    private PartyGameView? gameView;
    private HostGameViewPayload? game;
    private PartyPresenceSnapshot presence = new(0, 0, 0);
    private string? hostUserId;
    private string message = "Loading party...";
    private string connectionStatus = "Connecting";
    private string lastUpdateReason = "Initial state";
    private string? actionError;
    private bool actionPending;
    private bool closeConfirmationRequested;
    private string ConnectionBadgeClass => connectionStatus == "Connected"
        ? "text-bg-success"
        : connectionStatus == "Reconnecting" ? "text-bg-warning" : "text-bg-secondary";
    private string ConnectionLabel => connectionStatus switch
    {
        "Connected" => "Live",
        "Reconnecting" => "Reconnecting…",
        _ => "Offline"
    };

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hostUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? throw new InvalidOperationException("An authenticated host ID is required.");
        availableGames = PartyState.ListGames();

        try
        {
            await LoadAsync();
        }
        catch (PartyNotFoundException)
        {
            message = "Party not found.";
        }
        catch (PartyAccessDeniedException)
        {
            message = "You do not have permission to control this party.";
        }
    }

    private async Task StartGameAsync(string gameKey)
    {
        await RunActionAsync(async () =>
        {
            await PartyState.StartGameAsync(PartyId, hostUserId!, gameKey);
        });
    }

    private async Task AdvanceGameAsync()
    {
        if (game?.AdvanceActionKind is not { } actionKind)
        {
            return;
        }
        await RunActionAsync(async () =>
        {
            await PartyState.AdvanceGameAsync(PartyId, hostUserId!, actionKind);
        });
    }

    private async Task CloseLobbyAsync()
    {
        actionPending = true;
        actionError = null;
        try
        {
            await PartyState.CloseLobbyAsync(PartyId, hostUserId!);
            Navigation.NavigateTo("/host");
        }
        catch (InvalidOperationException exception)
        {
            actionError = exception.Message;
            closeConfirmationRequested = false;
        }
        finally
        {
            actionPending = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        actionPending = true;
        actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or GameRuleViolationException)
        {
            actionError = exception.Message;
        }
        finally
        {
            actionPending = false;
        }
    }

    private async Task RefreshFromServerAsync(string reason)
    {
        lastUpdateReason = reason;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var state = await PartyState.LoadAsync(PartyId, hostUserId!);
        party = state.Party;
        players = state.Players;
        presence = state.Presence;
        gameView = state.Game;
        game = gameView?.Data.Deserialize<HostGameViewPayload>();
    }

    private string PlayerName(Guid playerId) =>
        players.FirstOrDefault(player => player.PlayerId == playerId)?.DisplayName ?? "Player";

    private static string GameIcon(string gameKey) => gameKey switch
    {
        "animates" => "✎",
        "bullshit" => "!?",
        "estimate" => "≈",
        "majority-rules" => "★",
        _ => "▶"
    };

    private Task SetConnectionStatus(string status)
    {
        connectionStatus = status;
        return Task.CompletedTask;
    }
}
