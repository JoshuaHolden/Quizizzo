@page "/join/{RoomCode}"
@layout Quizizzo.Web.Components.Layout.LandingLayout
@using Quizizzo.Application.Parties
@using Quizizzo.Application.Players
@using Quizizzo.Domain
@inject PlayerService Players

<PageTitle>Join @RoomCode</PageTitle>

<div class="join-experience" data-landing-motion>
  <span class="join-orb join-orb-one" data-parallax-layer data-depth=".65" aria-hidden="true"></span>
  <span class="join-orb join-orb-two" data-parallax-layer data-depth="1.1" aria-hidden="true"></span>
  <div class="join-stage join-stage-party">
    @if (party is null)
    {
        <section class="join-card join-card-message" data-reveal>
            <span class="join-card-kicker">NOT QUITE</span>
            <h1>Can’t join yet.</h1>
            <p>@loadError</p>
            <a class="join-card-button" href="/join">Try another code <span aria-hidden="true">→</span></a>
        </section>
    }
    else
    {
        <section class="room-preview" data-reveal aria-labelledby="room-title">
            <p>YOU FOUND THE PARTY</p>
            <h1 id="room-title">Room <strong>@party.RoomCode</strong></h1>
            <span><i aria-hidden="true"></i> @party.PlayerCount of @party.MaximumPlayers players are in</span>
            <div class="room-characters" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </section>
        <section class="join-card join-designer-card" data-reveal data-reveal-delay="1" aria-label="Design your player">
            <span class="join-card-kicker">ALMOST THERE</span>
            <h2>Make your player</h2>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="join-error" role="alert">@Error</p>
            }
            <form method="post" action="/join-player" data-avatar-designer>
                <AntiforgeryToken />
                <input type="hidden" name="roomCode" value="@party.RoomCode" />
                <div class="avatar-preview" data-avatar-preview aria-label="Character preview"></div>
                <label for="display-name">Player name</label>
                <input id="display-name" name="displayName" maxlength="@QuizizzoLimits.PlayerNameLength"
                       autocomplete="nickname" placeholder="Your brilliant nickname" required />
                <div class="avatar-tabs" role="tablist" aria-label="Character sections">
                    <button type="button" role="tab" id="avatar-tab-head" aria-controls="avatar-panel-head" aria-selected="true" data-avatar-tab="head">Head</button>
                    <button type="button" role="tab" id="avatar-tab-body" aria-controls="avatar-panel-body" aria-selected="false" tabindex="-1" data-avatar-tab="body">Body</button>
                    <button type="button" role="tab" id="avatar-tab-legs" aria-controls="avatar-panel-legs" aria-selected="false" tabindex="-1" data-avatar-tab="legs">Legs</button>
                </div>
                <fieldset class="avatar-options" id="avatar-panel-head" role="tabpanel" aria-labelledby="avatar-tab-head" data-avatar-panel="head">
                    <legend class="visually-hidden">Head options</legend>
                    <label>Style<select name="presentation"><option>Man</option><option>Woman</option></select></label>
                    <label>Skin<select name="skinTone"><option value="Tint1">Warm</option><option value="Tint3">Golden</option><option value="Tint5">Brown</option><option value="Tint7">Deep</option></select></label>
                    <label>Hair colour<select name="hairColour"><option>Brown</option><option>Black</option><option>Blonde</option><option>Red</option></select></label>
                    <label>Hairstyle<select name="hairStyle" data-hair-style><option>Style1</option><option>Style2</option><option>Style3</option><option>Style4</option><option>Style5</option><option>Style6</option><option>Style7</option><option>Style8</option></select></label>
                    <label>Face shape<select name="faceShape"><option>Oval</option><option>Round</option><option>Wide</option></select></label>
                    <label>Eye colour<select name="eyeColour"><option>Blue</option><option>Brown</option><option>Green</option><option>Black</option><option>Pine</option></select></label>
                    <label>Eye size<select name="eyeSize"><option>Large</option><option>Small</option></select></label>
                    <label>Brows<select name="browShape"><option value="Brow1">Shape 1</option><option value="Brow2">Shape 2</option><option value="Brow3">Shape 3</option></select></label>
                    <label>Nose<select name="noseShape"><option value="Nose1">Shape 1</option><option value="Nose2">Shape 2</option><option value="Nose3">Shape 3</option></select></label>
                    <label>Mouth<select name="mouth"><option value="Smile">Smile</option><option value="Grin">Upper teeth</option><option value="TeethLower">Lower teeth</option><option value="Surprised">Surprised</option><option value="Tongue">Glad</option><option value="Sad">Sad</option><option value="Straight">Straight</option></select></label>
                </fieldset>
                <fieldset class="avatar-options" id="avatar-panel-body" role="tabpanel" aria-labelledby="avatar-tab-body" data-avatar-panel="body" hidden>
                    <legend class="visually-hidden">Body options</legend>
                    <label>Body size<select name="bodySize"><option>Thin</option><option selected>Normal</option><option>Thick</option></select></label>
                    <label>Shirt<select name="shirtColour"><option>Navy</option><option>Blue</option><option>Green</option><option>Red</option></select></label>
                    <label>Top style<select name="shirtStyle" data-shirt-style><option>Style1</option><option>Style2</option><option>Style3</option><option>Style5</option><option>Style6</option><option>Style7</option></select></label>
                </fieldset>
                <fieldset class="avatar-options" id="avatar-panel-legs" role="tabpanel" aria-labelledby="avatar-tab-legs" data-avatar-panel="legs" hidden>
                    <legend class="visually-hidden">Leg options</legend>
                    <label>Trousers<select name="trouserColour"><option>Navy</option><option>Blue</option><option>Green</option><option>Tan</option></select></label>
                    <label>Trouser style<select name="trouserStyle"><option>Style1</option><option>Style2</option><option>Style3</option><option>Style4</option></select></label>
                    <label>Length<select name="trouserLength"><option value="FullLength">Full length</option><option>Cropped</option><option>Shorts</option></select></label>
                    <label>Shoes<select name="shoeColour"><option>Brown</option><option>Black</option><option>Blue</option><option>Red</option></select></label>
                    <label>Shoe style<select name="shoeStyle"><option>Style1</option><option>Style2</option><option>Style3</option><option>Style4</option><option>Style5</option></select></label>
                </fieldset>
                <button type="submit">Join the party <span aria-hidden="true">→</span></button>
            </form>
            <a href="/join">Use a different code</a>
        </section>
    }
  </div>
</div>

@code {
    [Parameter] public string RoomCode { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private JoinPartyView? party;
    private string loadError = "Looking for that party…";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            party = await Players.GetJoinPartyAsync(RoomCode);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or PartyNotFoundException)
        {
            loadError = exception.Message;
        }
    }
}
