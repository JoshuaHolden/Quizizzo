@page "/host"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Quizizzo.Application.Parties
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PartyService Parties
@inject NavigationManager Navigation

<PageTitle>Host dashboard</PageTitle>

<div class="host-dashboard">
    <h1>Host your party</h1>

    @if (loading)
{
    <p>Loading your parties…</p>
}
else
{
    @if (activeParty is not null)
    {
        <section class="mt-4" aria-labelledby="active-party-heading">
            <h2 id="active-party-heading">Resume active party</h2>
            <a class="btn btn-primary btn-lg" href="@($"/host/party/{activeParty.PartyId}")">
                @activeParty.RoomCode · @activeParty.Status
            </a>
        </section>
    }
    else
    {
        <button class="btn btn-primary btn-lg" disabled="@creating" @onclick="CreatePartyAsync">
            @(creating ? "Creating…" : "Start new party")
        </button>
    }

    <section class="mt-4" aria-labelledby="recent-parties-heading">
        <h2 id="recent-parties-heading">Recent parties</h2>
        @if (recentParties.Count == 0)
        {
            <p>No parties yet. Start one when everyone is ready.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var party in recentParties)
                {
                    <li class="list-group-item responsive-list-row">
                        <a href="@($"/host/party/{party.PartyId}")">@party.RoomCode</a>
                        <span>@party.Status · @party.CreatedAt.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
    </section>
}
</div>

@code {
    private bool loading = true;
    private bool creating;
    private string hostUserId = string.Empty;
    private PartyView? activeParty;
    private IReadOnlyList<PartyView> recentParties = [];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hostUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? throw new InvalidOperationException("An authenticated host ID is required.");
        activeParty = await Parties.GetActiveAsync(hostUserId);
        recentParties = await Parties.ListRecentAsync(hostUserId);
        loading = false;
    }

    private async Task CreatePartyAsync()
    {
        if (activeParty is not null)
        {
            Navigation.NavigateTo($"/host/party/{activeParty.PartyId}");
            return;
        }
        creating = true;
        try
        {
            var party = await Parties.CreateAsync(hostUserId);
            Navigation.NavigateTo($"/host/party/{party.PartyId}");
        }
        catch (InvalidOperationException)
        {
            activeParty = await Parties.GetActiveAsync(hostUserId);
            if (activeParty is not null)
            {
                Navigation.NavigateTo($"/host/party/{activeParty.PartyId}");
            }
        }
        finally
        {
            creating = false;
        }
    }
}
