@using System.Text.Json
@using Microsoft.JSInterop
@using Quizizzo.Application.Games
@using Quizizzo.Application.Players
@using Quizizzo.GameContracts
@using Quizizzo.Web.Drawing
@using Quizizzo.Web.Presentation
@inject PlayerRealtimeStateLoader StateLoader
@implements IDisposable

<PartyRealtimeConnection @ref="partyConnection"
                         Role="Player"
                         PartyId="player.PartyId"
                         StateChanged="RefreshFromServerAsync"
                         ConnectionStatusChanged="SetConnectionStatus" />

<section class="join-panel player-controller-page @(game is null ? "player-controller-lobby" : "player-controller-active") @(game?.Controller.Kind == PlayerControllerKind.Arcade ? "player-controller-arcade" : null) mx-auto" aria-label="Player controller">
    <AntiforgeryToken />
    <header class="player-controller-header">
        <span class="player-room-chip">@player.RoomCode</span>
        <h1 @ref="pageHeading" tabindex="-1">@(game is null ? $"You're in, {player.DisplayName}!" : game.Heading)</h1>
        <div class="player-header-actions">
            <span class="player-connection-chip @ConnectionStatusClass" aria-live="polite">
                <span aria-hidden="true"></span>@ConnectionLabel
            </span>
            @if (game is not null && game.Controller.Kind != PlayerControllerKind.Arcade)
            {
                <span class="player-score-chip"
                      aria-label="@($"Party score {PlayerScore:N0}; {player.TotalWins} game wins")">
                    @PlayerScore.ToString("N0") @(game?.ScoreUnit ?? "pts") · 🏆 @player.TotalWins
                </span>
            }
            <button type="button"
                    class="player-reaction-trigger"
                    aria-label="Open reactions"
                    aria-expanded="@reactionsOpen"
                    aria-controls="player-reaction-popover"
                    @onclick="ToggleReactions">
                <span aria-hidden="true">☺</span>
            </button>
        </div>
    </header>

    <div class="character-preview mx-auto" style="background-color: @player.Character.PrimaryColour">
        <span aria-hidden="true">:)</span>
    </div>

    @if (reactionsOpen)
    {
        <aside id="player-reaction-popover" class="player-reaction-popover" role="dialog" aria-label="Send a reaction to the big screen">
            <div class="player-reaction-popover-header">
                <strong>Send to the big screen</strong>
                <button type="button" @onclick="CloseReactions" aria-label="Close reactions">×</button>
            </div>
            <div class="player-reactions">
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Kiss")' aria-label="Send a kiss">💋</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Angry")' aria-label="Show anger">😠</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Laugh")' aria-label="Laugh">😂</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Wow")' aria-label="Show surprise">😮</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Poop")' aria-label="Send poop">💩</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Fake")'>FAKE</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Unsubscribe")'>UNSUB</button>
                <button type="button" disabled="@(connectionStatus != "Connected")" @onclick='() => SendReactionAsync("Report")'>REPORT</button>
            </div>
        </aside>
    }

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="controller-notice" role="status" aria-live="polite">
            <span aria-hidden="true">✦</span>
            <div><strong>Not quite!</strong><p>@actionError</p></div>
        </div>
    }

    @if (gameView is null || game is null)
    {
        <p>Your character is ready. Keep this page open.</p>
        <p class="badge text-bg-success">@player.Status</p>
        <p>Party score: <strong>@player.Score.ToString("N0")</strong> · Game wins: <strong>@player.TotalWins</strong></p>
    }
    else
    {
        <section class="player-game-panel">
            @if (game.Media is { Items.Count: > 0 } media)
            {
                <section class="controller-game-media @($"controller-game-media-{media.Mode}")"
                         aria-label="Game media">
                    @foreach (var item in media.Items)
                    {
                        <article class="controller-game-media-card">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.AlternativeText" />
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Badge))
                            {
                                <span class="controller-game-media-badge">@item.Badge</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Heading))
                            {
                                <strong>@item.Heading</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Body))
                            {
                                <span>@item.Body</span>
                            }
                        </article>
                    }
                </section>
            }
            @if (game.Controller.Kind is not (PlayerControllerKind.Drawing or PlayerControllerKind.Recording or PlayerControllerKind.Rhythm or PlayerControllerKind.Arcade))
            {
                <p class="lead player-game-instructions">@game.Instructions</p>
                @if (gameView.PhaseEndsAtUtc is not null)
                {
                    <p class="fs-5 player-game-deadline"><DeadlineCountdown EndsAtUtc="gameView.PhaseEndsAtUtc" /></p>
                }
            }

            @switch (game.Controller.Kind)
            {
                case PlayerControllerKind.Number:
                    var configuration = game.Controller.Configuration.Deserialize<NumberControllerConfiguration>();
                    if (configuration is not null)
                    {
                        <NumberController @key="ControllerRenderKey"
                                          Configuration="configuration"
                                          SubmitLabel="@game.Controller.SubmitLabel"
                                          Disabled="@(submitting || connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                          Submitted="SubmitNumberAsync" />
                    }
                    break;
                case PlayerControllerKind.Drawing:
                    var drawingConfiguration = game.Controller.Configuration.Deserialize<DrawingControllerConfiguration>();
                    if (drawingConfiguration is not null)
                    {
                        <DrawingController @key="DrawingControllerKey(drawingConfiguration)"
                                           Options="CreateDrawingOptions(drawingConfiguration)"
                                           Prompt="@game.Instructions"
                                           EndsAtUtc="gameView.PhaseEndsAtUtc"
                                           SubmissionEndpoint="/api/drawing-submissions/animates"
                                           SubmitLabel="@game.Controller.SubmitLabel"
                                           Disabled="@(connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                           Submitted="DrawingSubmittedAsync" />
                    }
                    break;
                case PlayerControllerKind.Recording:
                    var recordingConfiguration = game.Controller.Configuration.Deserialize<RecordingControllerConfiguration>();
                    if (recordingConfiguration is not null)
                    {
                        <RecordingController @key="ControllerRenderKey"
                                             Configuration="recordingConfiguration"
                                             GameInstanceId="gameView.GameInstanceId"
                                             EndsAtUtc="gameView.PhaseEndsAtUtc"
                                             Disabled="@(connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                             Confirmed="() => SubmitPlayerActionAsync(game.Controller.ActionKind, new { })" />
                    }
                    break;
                case PlayerControllerKind.Rhythm:
                    var rhythmConfiguration = game.Controller.Configuration.Deserialize<RhythmControllerConfiguration>();
                    if (rhythmConfiguration is not null)
                    {
                        <RhythmController @key="ControllerRenderKey"
                                          Configuration="rhythmConfiguration"
                                          ConnectionKey="@partyConnection!.ConnectionKey"
                                          ActionKind="@game.Controller.ActionKind"
                                          Disabled="@(connectionStatus != "Connected" || !game.Controller.IsEnabled)" />
                    }
                    break;
                case PlayerControllerKind.Text:
                    var textConfiguration = game.Controller.Configuration.Deserialize<TextControllerConfiguration>();
                    if (textConfiguration is not null)
                    {
                        <TextController @key="ControllerRenderKey"
                                        Configuration="textConfiguration"
                                        SubmitLabel="@game.Controller.SubmitLabel"
                                        Disabled="@(submitting || connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                        Submitted="submission => SubmitPlayerActionAsync(game.Controller.ActionKind,
                                            new { value = submission.Value, values = submission.Values })" />
                    }
                    break;
                case PlayerControllerKind.Vote:
                    var voteConfiguration = game.Controller.Configuration.Deserialize<VoteControllerConfiguration>();
                    if (voteConfiguration is not null)
                    {
                        var voteActionKind = game.Controller.ActionKind;
                        var voteSelectionProperty = voteConfiguration.SelectionProperty;
                        <VoteController @key="ControllerRenderKey"
                                        Configuration="voteConfiguration"
                                        SubmitLabel="@game.Controller.SubmitLabel"
                                        Disabled="@(submitting || connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                        Submitted="optionId => SubmitSelectionAsync(voteActionKind, voteSelectionProperty, optionId)" />
                    }
                    break;
                case PlayerControllerKind.Choice:
                    var choiceConfiguration = game.Controller.Configuration.Deserialize<ChoiceControllerConfiguration>();
                    if (choiceConfiguration is not null)
                    {
                        var choiceActionKind = game.Controller.ActionKind;
                        var choiceSelectionProperty = choiceConfiguration.SelectionProperty;
                        <ChoiceController @key="ControllerRenderKey"
                                          Configuration="choiceConfiguration"
                                          SubmitLabel="@game.Controller.SubmitLabel"
                                          Disabled="@(submitting || connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                          Submitted="optionId => SubmitSelectionAsync(choiceActionKind, choiceSelectionProperty, optionId)" />
                    }
                    break;
                case PlayerControllerKind.Arcade:
                    var arcadeConfiguration = game.Controller.Configuration.Deserialize<ArcadeControllerConfiguration>();
                    if (arcadeConfiguration is not null)
                    {
                        <ArcadeController @key="ControllerRenderKey"
                                          Configuration="arcadeConfiguration"
                                          ConnectionKey="@partyConnection!.ConnectionKey"
                                          ActionKind="@game.Controller.ActionKind"
                                          EndsAtUtc="gameView.PhaseEndsAtUtc"
                                          Disabled="@(connectionStatus != "Connected" || !game.Controller.IsEnabled)"
                                          />
                    }
                    break;
                case PlayerControllerKind.Waiting:
                    <div class="waiting-controller" aria-live="polite">
                        <span class="waiting-pulse" aria-hidden="true"></span>
                        <p>Waiting for the other players or the host...</p>
                    </div>
                    break;
                default:
                    <p>This controller is not available yet.</p>
                    break;
            }

        </section>
    }
</section>

@code {
    [Parameter, EditorRequired] public PlayerView InitialPlayer { get; set; } = default!;

    private PartyRealtimeConnection? partyConnection;
    private ElementReference pageHeading;
    private PlayerView player = default!;
    private PartyGameView? gameView;
    private PlayerGameViewPayload? game;
    private string connectionStatus = "Connecting";
    private string? actionError;
    private CancellationTokenSource? errorDismissal;
    private bool submitting;
    private bool focusHeadingAfterRender;
    private bool reactionsOpen;
    private long loadVersion;
    private bool realtimeRefreshInProgress;
    private bool realtimeRefreshQueued;
    private int PlayerScore => gameView?.Scores.TryGetValue(player.PlayerId, out var score) == true
        ? score
        : player.Score;
    private string ConnectionStatusClass => connectionStatus == "Connected"
        ? "connected"
        : connectionStatus == "Reconnecting" ? "reconnecting" : "disconnected";
    private string ConnectionLabel => connectionStatus switch
    {
        "Connected" => "You're live",
        "Reconnecting" => "Reconnecting…",
        _ => "Connection lost"
    };
    private string ControllerRenderKey => gameView is null || game is null
        ? "lobby"
        : string.Join(':',
            gameView.GameInstanceId.ToString("N"),
            gameView.Phase,
            game.Controller.Kind,
            game.Controller.ActionKind,
            game.Heading,
            game.Instructions);

    protected override async Task OnInitializedAsync()
    {
        player = InitialPlayer;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusHeadingAfterRender)
        {
            return;
        }

        focusHeadingAfterRender = false;
        await pageHeading.FocusAsync(preventScroll: true);
    }

    private async Task SubmitNumberAsync(long value)
    {
        if (partyConnection is null || game?.Controller.ActionKind is not { Length: > 0 } actionKind)
        {
            return;
        }

        BeginSubmission();
        try
        {
            await partyConnection.InvokeAsync(
                "SubmitPlayerAction", Guid.NewGuid(), actionKind, new { value });
            await LoadAsync();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            ShowTransientError(exception);
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task SendReactionAsync(string reaction)
    {
        if (partyConnection is null)
        {
            return;
        }
        reactionsOpen = false;
        try
        {
            await partyConnection.InvokeAsync("SendReaction", reaction);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            ShowTransientError(exception);
        }
    }

    private void ToggleReactions() => reactionsOpen = !reactionsOpen;

    private void CloseReactions() => reactionsOpen = false;

    private async Task SubmitSelectionAsync(string actionKind, string propertyName, string optionId)
    {
        if (partyConnection is null || string.IsNullOrWhiteSpace(actionKind))
        {
            return;
        }
        await SubmitPlayerActionAsync(
            actionKind,
            new Dictionary<string, string> { [propertyName] = optionId });
    }

    private async Task SubmitPlayerActionAsync(string actionKind, object payload)
    {
        BeginSubmission();
        try
        {
            await partyConnection!.InvokeAsync(
                "SubmitPlayerAction", Guid.NewGuid(), actionKind, payload);
            await LoadAsync();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            ShowTransientError(exception);
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task RefreshFromServerAsync(string reason)
    {
        realtimeRefreshQueued = true;
        if (realtimeRefreshInProgress)
        {
            return;
        }

        realtimeRefreshInProgress = true;
        try
        {
            do
            {
                realtimeRefreshQueued = false;
                await LoadAsync();
            }
            while (realtimeRefreshQueued);
        }
        finally
        {
            realtimeRefreshInProgress = false;
        }
    }

    private async Task DrawingSubmittedAsync() => await LoadAsync();

    private void BeginSubmission()
    {
        submitting = true;
        errorDismissal?.Cancel();
        actionError = null;
        focusHeadingAfterRender = true;
    }

    private async Task LoadAsync()
    {
        var requestedVersion = Interlocked.Increment(ref loadVersion);
        var previousControllerKind = game?.Controller.Kind;
        var state = await StateLoader.LoadAsync(player.PlayerId);
        if (requestedVersion != Volatile.Read(ref loadVersion))
        {
            return;
        }
        player = state.Player;
        gameView = state.Game;
        game = gameView?.Data.Deserialize<PlayerGameViewPayload>();
        var nextControllerKind = game?.Controller.Kind;
        focusHeadingAfterRender |= previousControllerKind is not null &&
            previousControllerKind != nextControllerKind;
    }

    private Task SetConnectionStatus(string status)
    {
        connectionStatus = status;
        return Task.CompletedTask;
    }

    private void ShowTransientError(Exception exception)
    {
        errorDismissal?.Cancel();
        errorDismissal?.Dispose();
        errorDismissal = new CancellationTokenSource();
        actionError = FriendlyError(exception.Message);
        _ = DismissErrorAsync(errorDismissal);
    }

    private async Task DismissErrorAsync(CancellationTokenSource dismissal)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), dismissal.Token);
            if (ReferenceEquals(errorDismissal, dismissal))
            {
                actionError = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FriendlyError(string message)
    {
        const string cooldown = "Wait a moment before reacting again.";
        if (message.Contains(cooldown, StringComparison.OrdinalIgnoreCase))
        {
            return "Easy there — reactions need a two-second breather.";
        }

        const string hubMarker = "HubException:";
        var markerIndex = message.IndexOf(hubMarker, StringComparison.OrdinalIgnoreCase);
        var friendly = markerIndex >= 0
            ? message[(markerIndex + hubMarker.Length)..]
            : message;
        return friendly.Split(['\r', '\n', '@'], StringSplitOptions.RemoveEmptyEntries)[0].Trim();
    }

    public void Dispose()
    {
        errorDismissal?.Cancel();
        errorDismissal?.Dispose();
    }

    private DrawingControllerOptions CreateDrawingOptions(DrawingControllerConfiguration configuration) => new()
    {
        Identity = new DrawingDraftIdentity(
            player.PartyId,
            gameView!.GameInstanceId,
            configuration.DraftScope,
            player.PlayerId),
        LogicalWidth = configuration.LogicalWidth,
        LogicalHeight = configuration.LogicalHeight,
        FrameCount = configuration.FrameCount,
        OnionSkinEnabled = configuration.OnionSkinEnabled
    };

    private string DrawingControllerKey(DrawingControllerConfiguration configuration) =>
        $"{gameView!.GameInstanceId:N}:{configuration.DraftScope}:" +
        $"{configuration.LogicalWidth}x{configuration.LogicalHeight}:{configuration.FrameCount}:" +
        configuration.OnionSkinEnabled;
}
