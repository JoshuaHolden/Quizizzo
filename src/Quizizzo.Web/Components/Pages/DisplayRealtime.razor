@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Quizizzo.Application.Displays
@using Quizizzo.Application.Games
@using Quizizzo.Application.Parties
@using Quizizzo.Application.Players
@using Quizizzo.Domain
@using Quizizzo.Domain.Parties
@using Quizizzo.GameContracts
@using Quizizzo.Games.AniMates
@using Quizizzo.Games.PileUpPanic
@using Quizizzo.Games.VoiceChoon
@using Quizizzo.Web.Presentation
@using Quizizzo.Web.Realtime
@using Quizizzo.Web.Voice
@using Microsoft.JSInterop
@inject DisplayRealtimeStateLoader StateLoader
@inject HostPartyRealtimeService HostPartyState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject QrCodeService QrCodes
@inject VoiceChoonReplayService VoiceChoonReplays
@inject IJSRuntime JavaScript

<PartyRealtimeConnection Role="Display"
                         PartyId="session.PartyId"
                         StateChanged="RefreshFromServerAsync"
                         ConnectionStatusChanged="SetConnectionStatus"
                         PlayerReacted="HandlePlayerReactionAsync" />

@if (HasHostControls)
{
    <PartyRealtimeConnection Role="Host"
                             PartyId="session.PartyId"
                             StateChanged="RefreshFromServerAsync" />
}

<main class="display-stage text-center">
    <PhaserPresentation @ref="phaserPresentation" Snapshot="PresentationSnapshot"
                        CanManagePlayers="HasHostControls"
                        RemovePlayerRequested="RemovePlayerAsync"
                        Started="HandlePhaserStartedAsync"
                        Failed="HandlePhaserFailedAsync"
                        ReplayRecordingReady="HandleReplayRecordingReady" />
    @if (phaserFailed)
    {
        <section class="display-unsupported" role="alert">
            <h1>Unsupported browser</h1>
            <p>Quizizzo cannot run its display in this browser.</p>
        </section>
    }

    @if (HasHostControls)
    {
        <button type="button" class="display-host-controls-launch"
                aria-haspopup="dialog" aria-expanded="@hostControlsOpen"
                @onclick="OpenHostControls">
            <span aria-hidden="true">⚙</span> Host controls
        </button>
    }

    @if (IsVoiceChoonResult)
    {
        <section class="voicechoon-share-panel" aria-label="Save and share this VoiceChoon performance">
            <strong>Your music video is ready</strong>
            @if (savedReplay is not null)
            {
                <a href="@ReplayUrl" target="_blank" rel="noopener">Watch permanent replay</a>
                <button type="button" @onclick="CopyReplayLinkAsync">Copy replay link</button>
                <a href="@FacebookShareUrl" target="_blank" rel="noopener">Share link on Facebook</a>
                @if (HasHostControls)
                {
                    <button type="button" class="share-delete" @onclick="DeleteReplayAsync">Delete replay</button>
                }
            }
            @if (replayRecordingReady)
            {
                <button type="button" class="share-primary" @onclick="ShareVideoAsync">
                    @(nativeReplayShareAvailable ? "Share video" : "Download video")
                </button>
            }
            else
            {
                <span>Finishing video…</span>
            }
            @if (!string.IsNullOrWhiteSpace(replayStatus))
            {
                <small role="status">@replayStatus</small>
            }
        </section>
    }
</main>

@if (HasHostControls && hostControlsOpen)
{
    <div class="display-host-controls-backdrop" role="presentation" @onclick="CloseHostControls">
        <section class="display-host-controls" role="dialog" aria-modal="true"
                 aria-labelledby="display-host-controls-title" @onclick:stopPropagation="true">
            <header>
                <div>
                    <p>Room @hostParty!.RoomCode</p>
                    <h2 id="display-host-controls-title">Host controls</h2>
                </div>
                <button type="button" class="display-host-controls-close"
                        aria-label="Close host controls" @onclick="CloseHostControls">×</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(hostActionError))
            {
                <div class="alert alert-danger" role="alert">@hostActionError</div>
            }

            <p class="display-host-player-count">@players.Count player@(players.Count == 1 ? string.Empty : "s") joined</p>

            @if (players.Count > 0)
            {
                <details class="display-host-party-record">
                    <summary>
                        <div>
                            <p>Since this lobby started</p>
                            <h3 id="display-host-party-record-title">Party standings</h3>
                        </div>
                        <span>Overall score · game wins <b>View</b></span>
                    </summary>
                    <ol>
                        @foreach (var standing in players
                            .OrderByDescending(candidate => candidate.Score)
                            .ThenByDescending(candidate => candidate.TotalWins)
                            .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase))
                        {
                            <li>
                                <span class="display-host-standing-rank">#@(players
                                    .OrderByDescending(candidate => candidate.Score)
                                    .ThenByDescending(candidate => candidate.TotalWins)
                                    .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
                                    .ToList().IndexOf(standing) + 1)</span>
                                <div>
                                    <strong>@standing.DisplayName</strong>
                                    <small>@FormatWinBreakdown(standing)</small>
                                </div>
                                <span><strong>@standing.Score.ToString("N0")</strong> pts · 🏆 @standing.TotalWins</span>
                            </li>
                        }
                    </ol>
                </details>
            }

            @if (hostGameView is not null && hostGame is not null)
            {
                <section class="display-host-current-game">
                    <div class="display-host-current-game-heading">
                        <div>
                            <p>Live now · @hostGameView.Phase</p>
                            <h3>@hostGame.Title</h3>
                        </div>
                        @if (hostParty!.GameQueue.Count > 0)
                        {
                            <span>@hostParty.GameQueue.Count up next</span>
                        }
                    </div>
                    <p>@hostGame.Prompt</p>
                    <p>@hostGame.PhaseMessage</p>
                    @if (hostGameView.PhaseEndsAtUtc is not null)
                    {
                        <p><DeadlineCountdown EndsAtUtc="hostGameView.PhaseEndsAtUtc" /></p>
                    }
                    @if (hostGame.CanAdvance && hostGame.AdvanceActionKind is not null)
                    {
                        <button type="button" class="btn btn-primary btn-lg w-100"
                                disabled="@hostActionPending" @onclick="AdvanceGameAsync">
                            @(hostActionPending ? "Working…" : hostGame.AdvanceLabel)
                        </button>
                    }
                    @if (hostParty.GameQueue.Count > 0)
                    {
                        <div class="display-host-up-next-compact">
                            <strong>Party playlist</strong>
                            <ol>
                                @foreach (var queuedGame in hostParty.GameQueue)
                                {
                                    <li>@GameDisplayName(queuedGame.GameKey)</li>
                                }
                            </ol>
                            <small>The next game launches automatically when this one finishes.</small>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="display-host-game-picker" aria-labelledby="display-host-games-title">
                    <div class="display-host-picker-intro">
                        <div>
                            <p>Pick the next event</p>
                            <h3 id="display-host-games-title">Build your party</h3>
                        </div>
                        <span>Play one now or line up a playlist</span>
                    </div>

                    <div class="display-host-picker-layout">
                        <div class="display-host-game-catalogue">
                            @foreach (var availableGame in availableGames)
                            {
                                var canPlay = CanPlay(availableGame);
                                <article class="display-host-game-card @GameThemeClass(availableGame.Key)">
                                    <div class="display-host-game-art" aria-hidden="true">
                                        <span>@GameMonogram(availableGame.Key)</span>
                                    </div>
                                    <div class="display-host-game-copy">
                                        <header>
                                            <div>
                                                <span class="display-host-game-style">@availableGame.PlayStyle</span>
                                                <h4>@availableGame.DisplayName</h4>
                                            </div>
                                            <span class="display-host-game-players">@PlayerRangeLabel(availableGame)</span>
                                        </header>
                                        <p>@availableGame.Description</p>
                                        @if (availableGame.Key == AniMatesGameModule.GameKey)
                                        {
                                            <details class="display-host-game-setting">
                                                <summary>Drawing time per frame · @aniMatesDrawingSecondsPerFrame seconds</summary>
                                                <div class="display-host-game-setting-body">
                                                    <label for="animates-drawing-seconds">Seconds per frame</label>
                                                    <div>
                                                        <input id="animates-drawing-seconds" type="number"
                                                               min="@AniMatesGameModule.MinimumDrawingSecondsPerFrame"
                                                               max="@AniMatesGameModule.MaximumDrawingSecondsPerFrame"
                                                               step="5" inputmode="numeric"
                                                               @bind="aniMatesDrawingSecondsPerFrame"
                                                               @bind:event="oninput" />
                                                        <small>
                                                            3 frames: @FormatDuration(AniMatesGameModule.RoundOneFrameCount * aniMatesDrawingSecondsPerFrame)
                                                            · 5 frames: @FormatDuration(AniMatesGameModule.RoundTwoFrameCount * aniMatesDrawingSecondsPerFrame)
                                                        </small>
                                                    </div>
                                                </div>
                                            </details>
                                        }
                                        @if (availableGame.Key == VoiceChoonGameDefinition.GameKey)
                                        {
                                            <details class="display-host-game-setting">
                                                <summary>Difficulty · @voiceChoonDifficulty</summary>
                                                <div class="display-host-game-setting-body">
                                                    <label for="voicechoon-difficulty">Chart difficulty</label>
                                                    <select id="voicechoon-difficulty" @bind="voiceChoonDifficulty">
                                                        <option value="@VoiceChoonDifficulty.Easy">Easy</option>
                                                        <option value="@VoiceChoonDifficulty.Medium">Medium</option>
                                                        <option value="@VoiceChoonDifficulty.Hard">Hard</option>
                                                    </select>
                                                    <label for="voicechoon-song">Song</label>
                                                    <select id="voicechoon-song" @bind="voiceChoonSongKey">
                                                        @foreach (var song in VoiceChoonSongCatalog.Available)
                                                        {
                                                            <option value="@song.Key">@song.DisplayName</option>
                                                        }
                                                    </select>
                                                    <small>@VoiceChoonSongCatalog.GetDefinition(voiceChoonSongKey).RecordingMessage</small>
                                                    <small>Changes note density and timing windows, not the song.</small>
                                                    <label class="display-host-game-test-mode">
                                                        <input type="checkbox" @bind="voiceChoonSoloAutoplayTest" />
                                                        Solo autoplay test
                                                    </label>
                                                    <small>One player records every sound; the performance then plays perfectly without pad input.</small>
                                                </div>
                                            </details>
                                        }
                                        @if (!canPlay)
                                        {
                                            <p class="display-host-game-unavailable">@GameAvailability(availableGame)</p>
                                        }
                                        <footer>
                                            <button type="button" class="display-host-queue-add"
                                                    disabled="@(!canPlay || hostActionPending || hostParty!.GameQueue.Count >= Party.MaximumQueuedGames)"
                                                    @onclick="() => AddGameToQueueAsync(availableGame.Key)">
                                                <span aria-hidden="true">＋</span> Add to playlist
                                            </button>
                                            <button type="button" class="display-host-play-now"
                                                    disabled="@(!canPlay || hostActionPending)"
                                                    @onclick="() => StartGameAsync(availableGame.Key)">
                                                Play now <span aria-hidden="true">▶</span>
                                            </button>
                                        </footer>
                                    </div>
                                </article>
                            }
                        </div>

                        <aside class="display-host-game-queue" aria-labelledby="display-host-queue-title">
                            <header>
                                <div>
                                    <p>Automatic handoff</p>
                                    <h4 id="display-host-queue-title">Party playlist</h4>
                                </div>
                                <span>@hostParty!.GameQueue.Count/@Party.MaximumQueuedGames</span>
                            </header>
                            @if (hostParty.GameQueue.Count == 0)
                            {
                                <div class="display-host-queue-empty">
                                    <span aria-hidden="true">＋</span>
                                    <strong>Your playlist is empty</strong>
                                    <p>Add games in the order you want to play them.</p>
                                </div>
                            }
                            else
                            {
                                <ol>
                                    @for (var queueIndex = 0; queueIndex < hostParty.GameQueue.Count; queueIndex++)
                                    {
                                        var queuedGame = hostParty.GameQueue[queueIndex];
                                        var queuedDescriptor = FindGame(queuedGame.GameKey);
                                        <li>
                                            <span class="display-host-queue-number">@(queueIndex + 1)</span>
                                            <div>
                                                <strong>@(queuedDescriptor?.DisplayName ?? queuedGame.GameKey)</strong>
                                                <small>@QueueConfigurationSummary(queuedGame)</small>
                                            </div>
                                            <div class="display-host-queue-actions">
                                                <button type="button" disabled="@(queueIndex == 0 || hostActionPending)"
                                                        aria-label="Move @(queuedDescriptor?.DisplayName ?? queuedGame.GameKey) earlier"
                                                        @onclick="() => MoveQueuedGameAsync(queuedGame.QueueItemId, -1)">↑</button>
                                                <button type="button" disabled="@(queueIndex == hostParty.GameQueue.Count - 1 || hostActionPending)"
                                                        aria-label="Move @(queuedDescriptor?.DisplayName ?? queuedGame.GameKey) later"
                                                        @onclick="() => MoveQueuedGameAsync(queuedGame.QueueItemId, 1)">↓</button>
                                                <button type="button" disabled="@hostActionPending"
                                                        aria-label="Remove @(queuedDescriptor?.DisplayName ?? queuedGame.GameKey) from playlist"
                                                        @onclick="() => RemoveQueuedGameAsync(queuedGame.QueueItemId)">×</button>
                                            </div>
                                        </li>
                                    }
                                </ol>
                                <p class="display-host-queue-note">
                                    @(PlaylistCanStart
                                        ? "Scores and players carry through every game. There is no lobby break."
                                        : "The current player count does not fit every game in this playlist yet.")
                                </p>
                                <button type="button" class="display-host-start-playlist"
                                        disabled="@(!PlaylistCanStart || hostActionPending)"
                                        @onclick="StartGameQueueAsync">
                                    @(hostActionPending ? "Starting…" : StartPlaylistLabel)
                                    <span aria-hidden="true">▶</span>
                                </button>
                            }
                        </aside>
                    </div>
                </section>
            }

            <footer>
                @if (!closeConfirmationRequested)
                {
                    <button type="button" class="btn btn-outline-danger"
                            disabled="@hostActionPending"
                            @onclick="() => closeConfirmationRequested = true">Close party</button>
                }
                else
                {
                    <div class="display-host-close-confirmation" role="alert">
                        <strong>Close room @hostParty!.RoomCode permanently?</strong>
                        <div>
                            <button type="button" class="btn btn-danger" disabled="@hostActionPending"
                                    @onclick="ClosePartyAsync">Yes, close party</button>
                            <button type="button" class="btn btn-secondary" disabled="@hostActionPending"
                                    @onclick="() => closeConfirmationRequested = false">Keep it open</button>
                        </div>
                    </div>
                }
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public DisplaySessionView InitialSession { get; set; } = default!;
    [Parameter, EditorRequired] public PlayerView[] InitialPlayers { get; set; } = [];

    private DisplaySessionView session = default!;
    private IReadOnlyList<PlayerView> players = [];
    private PartyGameView? gameView;
    private DisplayGameViewPayload? game;
    private PartyView? hostParty;
    private PartyGameView? hostGameView;
    private HostGameViewPayload? hostGame;
    private IReadOnlyList<GameDescriptor> availableGames = [];
    private string? hostUserId;
    private string? hostActionError;
    private bool hostActionPending;
    private bool hostControlsOpen;
    private bool closeConfirmationRequested;
    private bool realtimeRefreshInProgress;
    private bool realtimeRefreshQueued;
    private int aniMatesDrawingSecondsPerFrame = AniMatesGameModule.DefaultDrawingSecondsPerFrame;
    private VoiceChoonDifficulty voiceChoonDifficulty = VoiceChoonDifficulty.Medium;
        private string voiceChoonSongKey = VoiceChoonSongCatalog.DefaultSongKey;
    private bool voiceChoonSoloAutoplayTest;
    private PhaserPresentation? phaserPresentation;
    private bool phaserFailed;
    private VoiceChoonReplayView? savedReplay;
    private Guid? savedReplayGameInstanceId;
    private bool replayRecordingReady;
    private bool nativeReplayShareAvailable;
    private string? replayStatus;
    private bool HasHostControls => hostParty is not null && hostUserId is not null && session.PartyId is not null;
    private string JoinUrl => $"{Navigation.BaseUri}join/{session.RoomCode}";
    private PhaserPresentationSnapshot PresentationSnapshot =>
        PhaserPresentationMapper.Create(
            session, players, gameView, game,
            session.IsPaired ? JoinUrl : null,
            session.IsPaired ? QrCodes.CreatePngDataUri(JoinUrl) : null) with
        {
            CaptureReplay = string.Equals(gameView?.GameKey, VoiceChoonGameDefinition.GameKey,
                StringComparison.Ordinal)
        };
    private bool IsVoiceChoonResult => gameView?.GameKey == VoiceChoonGameDefinition.GameKey &&
        gameView.Phase == VoiceChoonGameModule.ResultsPhase;
    private string ReplayUrl => savedReplay is null ? string.Empty :
        $"{Navigation.BaseUri}replay/voicechoon/{savedReplay.ShareCode}";
    private string FacebookShareUrl =>
        $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(ReplayUrl)}";
    private const string ReplayCaption =
        "We made this song using only our voices in Quizizzo VoiceChoon 🎤😂 Nobody asked for this, but here it is.";

    private Task HandlePhaserStartedAsync()
    {
        phaserFailed = false;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandlePhaserFailedAsync()
    {
        phaserFailed = true;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        session = InitialSession;
        players = InitialPlayers;
        await LoadStateAsync();
        await InitialiseHostControlsAsync();
    }

    private async Task RefreshFromServerAsync(string reason)
    {
        realtimeRefreshQueued = true;
        if (realtimeRefreshInProgress)
        {
            return;
        }

        realtimeRefreshInProgress = true;
        try
        {
            do
            {
                realtimeRefreshQueued = false;
                await LoadStateAsync();
                await LoadHostStateAsync();
            }
            while (realtimeRefreshQueued);
        }
        finally
        {
            realtimeRefreshInProgress = false;
        }
    }

    private async Task LoadStateAsync()
    {
        var state = await StateLoader.LoadAsync(session.DisplaySessionId);
        session = state.Session;
        players = state.Players;
        gameView = state.Game;
        game = gameView?.Data.Deserialize<DisplayGameViewPayload>();
        await EnsureReplaySavedAsync();
    }

    private async Task EnsureReplaySavedAsync()
    {
        if (!IsVoiceChoonResult || session.PartyId is not { } partyId ||
            gameView is null || savedReplayGameInstanceId == gameView.GameInstanceId) return;
        try
        {
            savedReplay = await VoiceChoonReplays.SaveAsync(partyId, PresentationSnapshot);
            savedReplayGameInstanceId = gameView.GameInstanceId;
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        {
            replayStatus = exception.Message;
        }
    }

    private Task HandleReplayRecordingReady(bool nativeShareAvailable)
    {
        replayRecordingReady = true;
        nativeReplayShareAvailable = nativeShareAvailable;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ShareVideoAsync()
    {
        if (phaserPresentation is null) return;
        if (nativeReplayShareAvailable && await phaserPresentation.ShareReplayAsync(ReplayCaption))
        {
            replayStatus = "Video handed to your sharing app.";
        }
        else
        {
            await phaserPresentation.DownloadReplayAsync("quizizzo-voicechoon");
            await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", ReplayCaption);
            replayStatus = "Video downloaded and funny caption copied.";
        }
    }

    private async Task CopyReplayLinkAsync()
    {
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", $"{ReplayCaption} {ReplayUrl}");
        replayStatus = "Replay link and caption copied.";
    }

    private async Task DeleteReplayAsync()
    {
        if (savedReplay is null || hostUserId is null) return;
        await VoiceChoonReplays.DeleteAsync(savedReplay.ShareCode, hostUserId);
        savedReplay = null;
        replayStatus = "Permanent replay and retained voice samples deleted.";
    }

    private async Task InitialiseHostControlsAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hostUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (hostUserId is null || session.PartyId is null)
        {
            return;
        }
        availableGames = HostPartyState.ListGames();
        await LoadHostStateAsync();
    }

    private async Task LoadHostStateAsync()
    {
        if (hostUserId is null || session.PartyId is not { } partyId)
        {
            return;
        }
        try
        {
            var state = await HostPartyState.LoadAsync(partyId, hostUserId);
            hostParty = state.Party;
            hostGameView = state.Game;
            hostGame = hostGameView?.Data.Deserialize<HostGameViewPayload>();
        }
        catch (Exception exception) when (exception is PartyAccessDeniedException or PartyNotFoundException)
        {
            hostParty = null;
            hostGameView = null;
            hostGame = null;
            hostControlsOpen = false;
        }
    }

    private async Task StartGameAsync(string gameKey) => await RunHostActionAsync(async () =>
    {
        await HostPartyState.StartGameAsync(
            session.PartyId!.Value, hostUserId!, gameKey, ConfigurationFor(gameKey));
    });

    private async Task AddGameToQueueAsync(string gameKey) => await RunHostActionAsync(async () =>
    {
        var queue = hostParty!.GameQueue
            .Select(ToQueueRequest)
            .Append(new PartyGameQueueRequest(Guid.NewGuid(), gameKey, ConfigurationFor(gameKey)))
            .ToArray();
        await HostPartyState.SaveGameQueueAsync(session.PartyId!.Value, hostUserId!, queue);
    });

    private async Task RemoveQueuedGameAsync(Guid queueItemId) => await RunHostActionAsync(async () =>
    {
        var queue = hostParty!.GameQueue
            .Where(item => item.QueueItemId != queueItemId)
            .Select(ToQueueRequest)
            .ToArray();
        await HostPartyState.SaveGameQueueAsync(session.PartyId!.Value, hostUserId!, queue);
    });

    private async Task MoveQueuedGameAsync(Guid queueItemId, int direction) => await RunHostActionAsync(async () =>
    {
        var queue = hostParty!.GameQueue.ToList();
        var currentIndex = queue.FindIndex(item => item.QueueItemId == queueItemId);
        var destinationIndex = currentIndex + direction;
        if (currentIndex < 0 || destinationIndex < 0 || destinationIndex >= queue.Count)
        {
            return;
        }

        (queue[currentIndex], queue[destinationIndex]) = (queue[destinationIndex], queue[currentIndex]);
        await HostPartyState.SaveGameQueueAsync(
            session.PartyId!.Value,
            hostUserId!,
            queue.Select(ToQueueRequest).ToArray());
    });

    private async Task StartGameQueueAsync() => await RunHostActionAsync(async () =>
    {
        await HostPartyState.StartGameQueueAsync(session.PartyId!.Value, hostUserId!);
    });

    private JsonElement ConfigurationFor(string gameKey) =>
        gameKey switch
        {
            AniMatesGameModule.GameKey =>
                GameJson.From(new AniMatesGameConfiguration(aniMatesDrawingSecondsPerFrame)),
            VoiceChoonGameDefinition.GameKey =>
                GameJson.From(new VoiceChoonGameConfiguration(
                    voiceChoonDifficulty,
                    voiceChoonSoloAutoplayTest,
                    voiceChoonSongKey)),
            _ => GameJson.Empty
        };

    private static PartyGameQueueRequest ToQueueRequest(PartyGameQueueItem item)
    {
        using var document = JsonDocument.Parse(item.ConfigurationJson);
        return new PartyGameQueueRequest(item.QueueItemId, item.GameKey, document.RootElement.Clone());
    }

    private GameDescriptor? FindGame(string gameKey) => availableGames.FirstOrDefault(game =>
        string.Equals(game.Key, gameKey, StringComparison.OrdinalIgnoreCase));

    private bool CanPlay(GameDescriptor game) =>
        hostParty?.Status == PartyStatus.Lobby &&
        (game.Key != VoiceChoonGameDefinition.GameKey || !voiceChoonSoloAutoplayTest || players.Count == 1) &&
        players.Count >= MinimumPlayersForCurrentSetup(game) &&
        players.Count <= MaximumPlayersForCurrentSetup(game);

    private int MinimumPlayersForCurrentSetup(GameDescriptor game) =>
        game.Key == VoiceChoonGameDefinition.GameKey && !voiceChoonSoloAutoplayTest
            ? VoiceChoonSongCatalog.GetDefinition(voiceChoonSongKey).MinimumPlayers
            : game.MinimumPlayers;

    private int MaximumPlayersForCurrentSetup(GameDescriptor game) =>
        game.Key == VoiceChoonGameDefinition.GameKey
            ? VoiceChoonSongCatalog.GetDefinition(voiceChoonSongKey).MaximumPlayers
            : game.MaximumPlayers;

    private string PlayerRangeLabel(GameDescriptor game) =>
        game.Key == VoiceChoonGameDefinition.GameKey
            ? $"{VoiceChoonSongCatalog.GetDefinition(voiceChoonSongKey).MinimumPlayers}–{VoiceChoonSongCatalog.GetDefinition(voiceChoonSongKey).MaximumPlayers} players · 1-player test"
            : $"{game.MinimumPlayers}–{game.MaximumPlayers} players";

    private bool PlaylistCanStart => hostParty is { Status: PartyStatus.Lobby, GameQueue.Count: > 0 } &&
        hostParty.GameQueue.All(item => FindGame(item.GameKey) is { } game && CanPlay(game));

    private string StartPlaylistLabel =>
        $"Start playlist · {hostParty!.GameQueue.Count} game{(hostParty.GameQueue.Count == 1 ? string.Empty : "s")}";

    private string GameAvailability(GameDescriptor game) =>
        game.Key == VoiceChoonGameDefinition.GameKey && voiceChoonSoloAutoplayTest && players.Count != 1
            ? "Solo autoplay test requires exactly one joined player"
            : players.Count < MinimumPlayersForCurrentSetup(game)
        ? $"Needs {MinimumPlayersForCurrentSetup(game) - players.Count} more player{(MinimumPlayersForCurrentSetup(game) - players.Count == 1 ? string.Empty : "s")}"
        : $"Supports up to {MaximumPlayersForCurrentSetup(game)} players";

    private static string GameThemeClass(string gameKey) => $"game-theme-{gameKey}";

    private static string GameMonogram(string gameKey) => gameKey switch
    {
        AniMatesGameModule.GameKey => "AM",
        PileUpPanicGameModule.GameKey => "PU",
        "slop-machine" => "SM",
        "bullshit" => "BS",
        "majority-rules" => "MR",
        "estimate" => "≋",
        _ => gameKey[..Math.Min(2, gameKey.Length)].ToUpperInvariant()
    };

    private static string QueueConfigurationSummary(PartyGameQueueItem item)
    {
        if (item.GameKey == VoiceChoonGameDefinition.GameKey)
        {
            try
            {
                var configuration = JsonSerializer.Deserialize<VoiceChoonGameConfiguration>(item.ConfigurationJson);
                return configuration is null
                    ? "Medium difficulty"
                                        : $"{VoiceChoonSongCatalog.GetDefinition(configuration.SongKey).DisplayName} · {configuration.Difficulty}"
                                            + (configuration.SoloAutoplayTest ? " · solo autoplay test" : string.Empty);
            }
            catch (JsonException)
            {
                return "Custom setup";
            }
        }
        if (item.GameKey != AniMatesGameModule.GameKey)
        {
            return "Standard setup";
        }

        try
        {
            var configuration = JsonSerializer.Deserialize<AniMatesGameConfiguration>(item.ConfigurationJson);
            return configuration is null
                ? "Standard setup"
                : $"{configuration.DrawingSecondsPerFrame}s per frame";
        }
        catch (JsonException)
        {
            return "Custom setup";
        }
    }

    private static string FormatDuration(int totalSeconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, totalSeconds));
        return duration.TotalMinutes >= 1
            ? $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s"
            : $"{duration.Seconds}s";
    }

    private string FormatWinBreakdown(PlayerView standing)
    {
        if (standing.GameWins is not { Count: > 0 } wins)
        {
            return "No game wins yet";
        }

        return string.Join(" · ", wins
            .OrderByDescending(win => win.Value)
            .ThenBy(win => win.Key, StringComparer.OrdinalIgnoreCase)
            .Select(win => $"{GameDisplayName(win.Key)} ×{win.Value}"));
    }

    private string GameDisplayName(string gameKey) =>
        availableGames.FirstOrDefault(game =>
            string.Equals(game.Key, gameKey, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? gameKey.Replace('-', ' ');

    private async Task AdvanceGameAsync()
    {
        if (hostGame?.AdvanceActionKind is not { } actionKind)
        {
            return;
        }
        await RunHostActionAsync(async () =>
        {
            await HostPartyState.AdvanceGameAsync(session.PartyId!.Value, hostUserId!, actionKind);
        });
    }

    private async Task ClosePartyAsync()
    {
        await RunHostActionAsync(async () =>
        {
            await HostPartyState.CloseLobbyAsync(session.PartyId!.Value, hostUserId!);
            Navigation.NavigateTo("/");
        });
    }

    private async Task RemovePlayerAsync(Guid playerId)
    {
        if (!HasHostControls || hostParty!.Status != PartyStatus.Lobby)
        {
            return;
        }

        await RunHostActionAsync(async () =>
        {
            await HostPartyState.KickPlayerAsync(session.PartyId!.Value, hostUserId!, playerId);
        });
    }

    private async Task RunHostActionAsync(Func<Task> action)
    {
        hostActionPending = true;
        hostActionError = null;
        try
        {
            await action();
            await LoadStateAsync();
            await LoadHostStateAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or GameRuleViolationException)
        {
            hostActionError = exception.Message;
        }
        finally
        {
            hostActionPending = false;
        }
    }

    private void OpenHostControls()
    {
        closeConfirmationRequested = false;
        hostActionError = null;
        hostControlsOpen = true;
    }

    private void CloseHostControls()
    {
        if (!hostActionPending)
        {
            closeConfirmationRequested = false;
            hostControlsOpen = false;
        }
    }

    private static Task SetConnectionStatus(string status) => Task.CompletedTask;

    private async Task HandlePlayerReactionAsync(PlayerReactionMessage message)
    {
        if (phaserPresentation is not null)
        {
            await phaserPresentation.ReactAsync(message.PlayerId, message.Reaction);
        }
    }
}
