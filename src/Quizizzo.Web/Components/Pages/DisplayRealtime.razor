@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Quizizzo.Application.Displays
@using Quizizzo.Application.Games
@using Quizizzo.Application.Parties
@using Quizizzo.Application.Players
@using Quizizzo.Domain
@using Quizizzo.Domain.Parties
@using Quizizzo.GameContracts
@using Quizizzo.Web.Presentation
@using Quizizzo.Web.Realtime
@inject DisplayRealtimeStateLoader StateLoader
@inject HostPartyRealtimeService HostPartyState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject QrCodeService QrCodes

<PartyRealtimeConnection Role="Display"
                         PartyId="session.PartyId"
                         StateChanged="RefreshFromServerAsync"
                         ConnectionStatusChanged="SetConnectionStatus"
                         PlayerReacted="HandlePlayerReactionAsync" />

@if (HasHostControls)
{
    <PartyRealtimeConnection Role="Host"
                             PartyId="session.PartyId"
                             StateChanged="RefreshFromServerAsync" />
}

<main class="display-stage text-center @(phaserReady ? "phaser-enhanced" : null) @DisplayPhaseClass">
    <PhaserPresentation @ref="phaserPresentation" Snapshot="PresentationSnapshot" Started="HandlePhaserStartedAsync" />
    <div class="display-overlay">
        <h1 class="display-2 fw-bold">QUIZIZZO</h1>
        <span class="badge display-connection-pill @ConnectionBadgeClass"
              aria-live="polite">@ConnectionLabel</span>

        @if (!session.IsPaired)
        {
            <section class="display-card display-pairing-card">
                <h2>Pair this screen</h2>
                <p>Open this address on the host's phone:</p>
                <img class="qr-code" src="@QrCodes.CreatePngDataUri(PairingUrl)" alt="QR code to pair this display" width="280" height="280" />
                <p class="fs-4 display-url"><a href="@PairingPath">@PairingUrl</a></p>
                <p>Pairing code</p>
                <p class="display-4 fw-bold">@session.PairingCode</p>
                <p>Expires @session.PairingExpiresAt.ToLocalTime().ToString("t").</p>
            </section>
        }
        else if (gameView is not null && game is not null)
        {
            <section class="display-game-panel">
                <header class="display-game-header">
                    <p class="text-uppercase mb-1">@game.Title</p>
                    <h2 class="display-4 fw-bold">@game.Prompt</h2>
                    <p class="fs-3">@game.PhaseMessage</p>
                </header>
                @if (gameView.PhaseEndsAtUtc is not null)
                {
                    <p class="display-deadline" aria-label="Time remaining"><DeadlineCountdown EndsAtUtc="gameView.PhaseEndsAtUtc" /></p>
                }

                <div class="display-results display-game-entries @(ShowEntriesOverCanvas ? "canvas-side-cards" : "canvas-duplicate")">
                    @foreach (var entry in game.Entries)
                    {
                        <article class="display-result-card @(gameView.GameKey == "animates" && gameView.Phase == "Choosing" ? "animates-answer-card" : null)">
                            <h3>@entry.Label</h3>
                            <p>@entry.Value</p>
                            @if (entry.Rank is not null)
                            {
                                <strong>#@entry.Rank - +@entry.PointsAwarded.ToString("N0") points</strong>
                            }
                        </article>
                    }
                </div>

                @if (game.Drawing is { Animations.Count: > 0 } drawing)
                {
                    <div class="drawing-display-fallback" aria-live="polite">
                        @foreach (var animation in drawing.Animations)
                        {
                            <article>
                                <FrameAnimation FrameAssetIds="animation.FrameAssetIds"
                                                FrameDurationMilliseconds="drawing.FrameDurationMilliseconds"
                                                AlternativeText="@animation.Prompt" />
                                <p>@animation.Prompt</p>
                                @if (!string.IsNullOrWhiteSpace(animation.CreatorName))
                                {
                                    <strong>@animation.CreatorName — @animation.Votes vote(s)</strong>
                                }
                            </article>
                        }
                    </div>
                }

                @if (game.Tutorial is { } tutorial)
                {
                    <section class="drawing-tutorial-fallback" aria-labelledby="drawing-tutorial-title">
                        <h3 id="drawing-tutorial-title">@tutorial.Title</h3>
                        <div class="tutorial-frame-strip" aria-label="@tutorial.FrameCount animation frames">
                            @for (var frame = 1; frame <= tutorial.FrameCount; frame++)
                            {
                                <span>Frame @frame</span>
                            }
                        </div>
                        <ol>
                            @foreach (var step in tutorial.Steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </section>
                }

                <div class="display-score-panel">
                    <h3>Scores</h3>
                    <ol class="scoreboard display-scoreboard">
                        @foreach (var score in gameView.Scores.OrderByDescending(pair => pair.Value))
                        {
                            <li><span>@PlayerName(score.Key)</span><strong>@score.Value.ToString("N0")</strong></li>
                        }
                    </ol>
                </div>
            </section>
        }
        else
        {
            <section class="display-lobby-panel">
                <h2>JOIN THE PARTY</h2>
                <p class="display-1 fw-bold">@session.RoomCode</p>
                <img class="qr-code" src="@QrCodes.CreatePngDataUri(JoinUrl)" alt="QR code to join room @session.RoomCode" width="280" height="280" />
                <p class="display-url"><a href="@JoinUrl">@JoinUrl</a></p>
                @if (players.Count == 0)
                {
                    <p>Waiting for players...</p>
                }
                else
                {
                    <p class="visually-hidden" aria-live="polite">
                        @players.Count players joined: @string.Join(", ", players.Select(player => player.DisplayName))
                    </p>
                }
            </section>
        }
    </div>

    @if (HasHostControls)
    {
        <button type="button" class="display-host-controls-launch"
                aria-haspopup="dialog" aria-expanded="@hostControlsOpen"
                @onclick="OpenHostControls">
            <span aria-hidden="true">⚙</span> Host controls
        </button>
    }
</main>

@if (HasHostControls && hostControlsOpen)
{
    <div class="display-host-controls-backdrop" role="presentation" @onclick="CloseHostControls">
        <section class="display-host-controls" role="dialog" aria-modal="true"
                 aria-labelledby="display-host-controls-title" @onclick:stopPropagation="true">
            <header>
                <div>
                    <p>Room @hostParty!.RoomCode</p>
                    <h2 id="display-host-controls-title">Host controls</h2>
                </div>
                <button type="button" class="display-host-controls-close"
                        aria-label="Close host controls" @onclick="CloseHostControls">×</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(hostActionError))
            {
                <div class="alert alert-danger" role="alert">@hostActionError</div>
            }

            <p class="display-host-player-count">@players.Count player@(players.Count == 1 ? string.Empty : "s") joined</p>

            @if (hostGameView is not null && hostGame is not null)
            {
                <section class="display-host-current-game">
                    <p>@hostGameView.Phase</p>
                    <h3>@hostGame.Title</h3>
                    <p>@hostGame.Prompt</p>
                    <p>@hostGame.PhaseMessage</p>
                    @if (hostGame.CanAdvance && hostGame.AdvanceActionKind is not null)
                    {
                        <button type="button" class="btn btn-primary btn-lg w-100"
                                disabled="@hostActionPending" @onclick="AdvanceGameAsync">
                            @(hostActionPending ? "Working…" : hostGame.AdvanceLabel)
                        </button>
                    }
                </section>
            }
            else
            {
                <section aria-labelledby="display-host-games-title">
                    <h3 id="display-host-games-title">Choose a game</h3>
                    <div class="display-host-game-grid">
                        @foreach (var availableGame in availableGames)
                        {
                            <button type="button"
                                    disabled="@(players.Count < availableGame.MinimumPlayers ||
                                        players.Count > availableGame.MaximumPlayers || hostActionPending ||
                                        hostParty!.Status != PartyStatus.Lobby)"
                                    @onclick="() => StartGameAsync(availableGame.Key)">
                                <strong>@availableGame.DisplayName</strong>
                                <span>@availableGame.MinimumPlayers–@availableGame.MaximumPlayers players</span>
                            </button>
                        }
                    </div>
                </section>
            }

            <footer>
                @if (!closeConfirmationRequested)
                {
                    <button type="button" class="btn btn-outline-danger"
                            disabled="@hostActionPending"
                            @onclick="() => closeConfirmationRequested = true">Close party</button>
                }
                else
                {
                    <div class="display-host-close-confirmation" role="alert">
                        <strong>Close room @hostParty!.RoomCode permanently?</strong>
                        <div>
                            <button type="button" class="btn btn-danger" disabled="@hostActionPending"
                                    @onclick="ClosePartyAsync">Yes, close party</button>
                            <button type="button" class="btn btn-secondary" disabled="@hostActionPending"
                                    @onclick="() => closeConfirmationRequested = false">Keep it open</button>
                        </div>
                    </div>
                }
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public DisplaySessionView InitialSession { get; set; } = default!;
    [Parameter, EditorRequired] public PlayerView[] InitialPlayers { get; set; } = [];

    private DisplaySessionView session = default!;
    private IReadOnlyList<PlayerView> players = [];
    private PartyGameView? gameView;
    private DisplayGameViewPayload? game;
    private PartyView? hostParty;
    private PartyGameView? hostGameView;
    private HostGameViewPayload? hostGame;
    private IReadOnlyList<GameDescriptor> availableGames = [];
    private string? hostUserId;
    private string? hostActionError;
    private bool hostActionPending;
    private bool hostControlsOpen;
    private bool closeConfirmationRequested;
    private string connectionStatus = "Connecting";
    private PhaserPresentation? phaserPresentation;
    private bool phaserReady;
    private bool HasHostControls => hostParty is not null && hostUserId is not null && session.PartyId is not null;
    private string PairingPath => $"host/pair-display/{session.PairingCode}";
    private string PairingUrl => $"{Navigation.BaseUri}{PairingPath}";
    private string JoinUrl => $"{Navigation.BaseUri}join/{session.RoomCode}";
    private PhaserPresentationSnapshot PresentationSnapshot =>
        PhaserPresentationMapper.Create(session, players, gameView, game);
    private string ConnectionBadgeClass => connectionStatus == "Connected"
        ? "text-bg-success"
        : connectionStatus == "Reconnecting" ? "text-bg-warning" : "text-bg-secondary";
    private bool ShowEntriesOverCanvas => gameView?.GameKey == "animates"
        && (gameView.Phase is "Choosing" or "Results")
        && game?.Entries.Count > 0;
    private string DisplayPhaseClass => gameView?.Phase switch
    {
        "Briefing" or "ShowdownBriefing" => "display-phase-briefing",
        "Choosing" or "Results" => "display-phase-with-cards",
        _ => string.Empty
    };

    private Task HandlePhaserStartedAsync()
    {
        phaserReady = true;
        return InvokeAsync(StateHasChanged);
    }
    private string ConnectionLabel => connectionStatus switch
    {
        "Connected" => "Live",
        "Reconnecting" => "Reconnecting…",
        _ => "Offline"
    };

    protected override async Task OnInitializedAsync()
    {
        session = InitialSession;
        players = InitialPlayers;
        await LoadStateAsync();
        await InitialiseHostControlsAsync();
    }

    private async Task RefreshFromServerAsync(string reason)
    {
        await LoadStateAsync();
        await LoadHostStateAsync();
    }

    private async Task LoadStateAsync()
    {
        var state = await StateLoader.LoadAsync(session.DisplaySessionId);
        session = state.Session;
        players = state.Players;
        gameView = state.Game;
        game = gameView?.Data.Deserialize<DisplayGameViewPayload>();
    }

    private async Task InitialiseHostControlsAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        hostUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (hostUserId is null || session.PartyId is null)
        {
            return;
        }
        availableGames = HostPartyState.ListGames();
        await LoadHostStateAsync();
    }

    private async Task LoadHostStateAsync()
    {
        if (hostUserId is null || session.PartyId is not { } partyId)
        {
            return;
        }
        try
        {
            var state = await HostPartyState.LoadAsync(partyId, hostUserId);
            hostParty = state.Party;
            hostGameView = state.Game;
            hostGame = hostGameView?.Data.Deserialize<HostGameViewPayload>();
        }
        catch (Exception exception) when (exception is PartyAccessDeniedException or PartyNotFoundException)
        {
            hostParty = null;
            hostGameView = null;
            hostGame = null;
            hostControlsOpen = false;
        }
    }

    private async Task StartGameAsync(string gameKey) => await RunHostActionAsync(async () =>
    {
        await HostPartyState.StartGameAsync(session.PartyId!.Value, hostUserId!, gameKey);
    });

    private async Task AdvanceGameAsync()
    {
        if (hostGame?.AdvanceActionKind is not { } actionKind)
        {
            return;
        }
        await RunHostActionAsync(async () =>
        {
            await HostPartyState.AdvanceGameAsync(session.PartyId!.Value, hostUserId!, actionKind);
        });
    }

    private async Task ClosePartyAsync()
    {
        await RunHostActionAsync(async () =>
        {
            await HostPartyState.CloseLobbyAsync(session.PartyId!.Value, hostUserId!);
            Navigation.NavigateTo("/host");
        });
    }

    private async Task RunHostActionAsync(Func<Task> action)
    {
        hostActionPending = true;
        hostActionError = null;
        try
        {
            await action();
            await LoadStateAsync();
            await LoadHostStateAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or GameRuleViolationException)
        {
            hostActionError = exception.Message;
        }
        finally
        {
            hostActionPending = false;
        }
    }

    private void OpenHostControls()
    {
        closeConfirmationRequested = false;
        hostActionError = null;
        hostControlsOpen = true;
    }

    private void CloseHostControls()
    {
        if (!hostActionPending)
        {
            closeConfirmationRequested = false;
            hostControlsOpen = false;
        }
    }

    private string PlayerName(Guid playerId) =>
        players.FirstOrDefault(player => player.PlayerId == playerId)?.DisplayName ?? "Player";

    private Task SetConnectionStatus(string status)
    {
        connectionStatus = status;
        return Task.CompletedTask;
    }

    private async Task HandlePlayerReactionAsync(PlayerReactionMessage message)
    {
        if (phaserPresentation is not null)
        {
            await phaserPresentation.ReactAsync(message.PlayerId, message.Reaction);
        }
    }
}
