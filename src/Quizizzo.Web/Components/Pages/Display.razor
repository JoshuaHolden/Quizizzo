@page "/display"
@layout Quizizzo.Web.Components.Layout.DisplayLayout
@using Quizizzo.Application.Displays
@using Quizizzo.Application.Players
@inject PlayerService Players

<PageTitle>Quizizzo display</PageTitle>

@if (session is null)
{
    <main class="display-stage text-center">
        <h1>Unable to initialise this display.</h1>
    </main>
}
else
{
    <DisplayRealtime InitialSession="session"
                     InitialPlayers="players.ToArray()"
                     @rendermode="InteractiveServer" />
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private DisplaySessionView? session;
    private IReadOnlyList<PlayerView> players = [];

    protected override async Task OnInitializedAsync()
    {
        session = HttpContext?.Items["Quizizzo.DisplaySession"] as DisplaySessionView;
        if (session?.PartyId is { } partyId)
        {
            players = await Players.ListForDisplayAsync(partyId);
        }
    }
}
