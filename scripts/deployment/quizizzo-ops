#!/bin/sh

set -eu

app_root=/opt/quizizzo
compose_file="$app_root/compose.yaml"
env_file="$app_root/.env"
backup_root="$app_root/backups"
project_name=quizizzo

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$env_file" \
        --file "$compose_file" \
        "$@"
}

read_image()
{
    sed -n 's/^QUIZIZZO_IMAGE=//p' "$env_file"
}

validate_image()
{
    image=$1
    if ! printf '%s\n' "$image" |
        grep -Eq '^ghcr\.io/joshuaholden/quizizzo:sha-[0-9a-f]{40}$'; then
        echo "The image must be an immutable Quizizzo commit tag." >&2
        exit 1
    fi
}

compose_with_image()
{
    image=$1
    shift
    (
        export QUIZIZZO_IMAGE="$image"
        compose "$@"
    )
}

require_baseline()
{
    test -f "$compose_file"
    test -f "$env_file"
    test "$(stat -c '%U:%G' "$compose_file")" = "root:root"
    test "$(stat -c '%U:%G' "$env_file")" = "root:root"
    test "$(stat -c '%a' "$env_file")" = "600"

    image=$(read_image)
    validate_image "$image"

    compose config --quiet
}

protected_container_ids()
{
    for container in logiagraph-app logiagraph-postgres logiagraph-redis; do
        docker inspect --format '{{.Id}}' "$container"
    done
}

require_protected_containers()
{
    for container in logiagraph-app logiagraph-postgres logiagraph-redis; do
        running=$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)
        if [ "$running" != "true" ]; then
            echo "Protected container $container is not running." >&2
            exit 1
        fi
    done
}

preflight()
{
    require_baseline

    image=$(read_image)
    docker manifest inspect "$image" >/dev/null
    nginx -t >/dev/null

    available_kb=$(df --output=avail / | tail -n 1 | tr -d ' ')
    if [ "$available_kb" -lt 5242880 ]; then
        echo "Less than 5 GiB is available on the root filesystem." >&2
        exit 1
    fi

    if ss -H -ltn 'sport = :8081' | grep -q .; then
        owner=$(docker ps --filter publish=8081 --quiet | head -n 1)
        owner_project=$(docker inspect \
            --format '{{index .Config.Labels "com.docker.compose.project"}}' "$owner")
        owner_service=$(docker inspect \
            --format '{{index .Config.Labels "com.docker.compose.service"}}' "$owner")
        if [ "$owner_project" != "quizizzo" ] || [ "$owner_service" != "quizizzo" ]; then
            echo "Port 8081 is occupied by an unexpected process or container." >&2
            exit 1
        fi
    fi

    require_protected_containers

    echo "Quizizzo preflight passed."
}

backup()
{
    require_baseline
    install -d -m 700 -o root -g root "$backup_root"

    postgres_id=$(compose ps --quiet postgres)
    if [ -z "$postgres_id" ] ||
        [ "$(docker inspect --format '{{.State.Health.Status}}' "$postgres_id")" != "healthy" ]; then
        echo "Quizizzo PostgreSQL is not healthy; no backup was created." >&2
        exit 1
    fi

    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    destination="$backup_root/quizizzo-$timestamp.dump"
    temporary="$destination.partial"

    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    compose exec -T postgres \
        pg_dump --username quizizzo --dbname quizizzo --format custom > "$temporary"
    test -s "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$destination"
    sha256sum "$destination" > "$destination.sha256"
    chmod 600 "$destination.sha256"
    trap - EXIT HUP INT TERM

    echo "Created $(basename "$destination")"
}

record_image()
{
    image=$1
    previous=$2
    temporary=$(mktemp "$app_root/.env.XXXXXX")
    trap 'rm -f "$temporary"' EXIT HUP INT TERM

    sed "s|^QUIZIZZO_IMAGE=.*$|QUIZIZZO_IMAGE=$image|" "$env_file" > "$temporary"
    chown root:root "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$env_file"
    printf '%s\n' "$image" > "$app_root/.current-image"
    printf '%s\n' "$previous" > "$app_root/.previous-image"
    chmod 600 "$app_root/.current-image" "$app_root/.previous-image"
    trap - EXIT HUP INT TERM
}

wait_for_health()
{
    attempt=1
    while [ "$attempt" -le 30 ]; do
        if curl --fail --silent --show-error \
            --header 'Host: quizizzo.com' \
            http://127.0.0.1:8081/health/live >/dev/null &&
            curl --fail --silent --show-error \
                --header 'Host: quizizzo.com' \
                http://127.0.0.1:8081/health/ready >/dev/null; then
            return 0
        fi
        sleep 2
        attempt=$((attempt + 1))
    done
    return 1
}

release()
{
    operation=$1
    image=$2
    validate_image "$image"
    require_baseline
    preflight
    docker manifest inspect "$image" >/dev/null

    previous=$(read_image)
    protected_before=$(protected_container_ids)

    docker pull "$image"
    compose_with_image "$image" up -d --wait postgres redis
    backup

    if [ "$operation" = "deploy" ]; then
        compose_with_image "$image" run --rm migrate
    fi

    compose_with_image "$image" up -d --no-deps --force-recreate quizizzo
    if ! wait_for_health; then
        echo "Quizizzo health verification failed." >&2
        echo "Rollback target: $previous" >&2
        exit 1
    fi

    protected_after=$(protected_container_ids)
    if [ "$protected_before" != "$protected_after" ]; then
        echo "A protected Logiagraph container identity changed; release not recorded." >&2
        exit 1
    fi
    require_protected_containers
    record_image "$image" "$previous"
    echo "Quizizzo $operation completed with $image"
}

case "${1:-}" in
    preflight)
        test "$#" -eq 1
        preflight
        ;;
    backup)
        test "$#" -eq 1
        backup
        ;;
    deploy)
        test "$#" -eq 2
        release deploy "$2"
        ;;
    rollback)
        test "$#" -eq 2
        release rollback "$2"
        ;;
    *)
        echo "Usage: $0 {preflight|backup|deploy IMAGE|rollback IMAGE}" >&2
        exit 64
        ;;
esac
